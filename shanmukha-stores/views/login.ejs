<%- include('./partials/navbar') %>

  <section class="auth-section">
    <div class="auth-container">
      <div class="auth-left">
        <div class="section-label" style="margin-bottom:16px">Welcome Back</div>
        <h1>Sign In to<br>Your Account</h1>
        <p>Access your orders, wishlist, and exclusive deals — all in one place.</p>
        <div class="auth-benefit"><span class="icon">📦</span> Track your live orders</div>
        <div class="auth-benefit"><span class="icon">❤️</span> Save items to wishlist</div>
        <div class="auth-benefit"><span class="icon">⚡</span> Faster checkout every time</div>
        <div class="auth-benefit"><span class="icon">🎁</span> Exclusive member offers</div>
      </div>
      <div class="auth-card">
        <h2>Login</h2>
        <% if (typeof error !=='undefined' && error) { %>
          <div class="auth-alert error">⚠️ <%= error %>
          </div>
          <% } %>
            <% if (typeof success !=='undefined' && success) { %>
              <div class="auth-alert success">✅ <%= success %>
              </div>
              <% } %>
                <div style="display:flex; gap:16px; margin-bottom:24px; border-bottom:1px solid #eee;">
                  <button type="button" class="tab-btn" id="tabPassword" onclick="switchLoginTab('password')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; cursor:pointer; border-bottom:2px solid #2c7a4b; color:#2c7a4b;">Password</button>
                  <button type="button" class="tab-btn" id="tabOTP" onclick="switchLoginTab('otp')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; cursor:pointer; color:var(--gray-500);">OTP</button>
                </div>

                <form action="/auth/login" method="POST" class="auth-form" id="passwordForm">
                  <div class="form-group">
                    <label class="form-label">Email or Mobile Number *</label>
                    <input type="text" name="login_id" class="form-input" placeholder="Email or Mobile Number" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="password-wrap">
                      <input type="password" name="password" class="form-input" placeholder="Enter your password" required
                        id="loginPass" autocomplete="current-password">
                      <span class="toggle-pass" onclick="togglePass('loginPass', this)">👁</span>
                    </div>
                    <div style="margin-top:8px;text-align:right;">
                      <a href="/auth/forgot-password" style="font-size:12px;color:#666;">Forgot password?</a>
                    </div>
                  </div>
                  <button type="submit" class="auth-btn">Login →</button>
                </form>

                <form action="/auth/login-otp" method="POST" class="auth-form" id="otpForm" style="display:none;" onsubmit="return validateOtpForm()">
                  <div class="form-group">
                    <label class="form-label">Mobile Number *</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="tel" id="loginPhone" name="phone" class="form-input" required autocomplete="tel" style="flex: 1;" placeholder="Enter mobile number">
                        <button type="button" class="auth-btn" id="sendLoginOtpBtn" onclick="sendLoginOTP()" style="width: auto; padding: 0 16px; font-size: 14px;">Send OTP</button>
                    </div>
                  </div>
                  <div class="form-group" id="loginOtpGroup" style="display: none;">
                    <label class="form-label">OTP *</label>
                    <input type="text" name="otp" id="loginOtp" class="form-input" placeholder="Enter OTP">
                    <small id="loginOtpMessage" style="color: #2c7a4b; display: block; margin-top: 4px; font-size: 12px;"></small>
                  </div>
                  <button type="submit" class="auth-btn" id="submitOtpBtn" style="display:none; margin-top:16px;">Login with OTP →</button>
                </form>
                <div class="auth-bottom">
                  Don't have an account? <a href="/auth/register">Sign Up</a>
                </div>

                <div class="auth-divider">
                  <span>OR</span>
                </div>

                <div class="social-auth-wrap">
                  <a href="/auth/google" class="google-auth-btn" id="googleLoginBtn">
                    <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24">
                      <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
                      <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.27 21.39 7.35 24 12 24z"/>
                      <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.16 0 9.98 0 12s.45 3.84 1.25 5.42l4.03-3.15z"/>
                      <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.27 2.61 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                    </svg>
                    <span>Sign in with Google</span>
                  </a>
                </div>
      </div>
    </div>
  </section>

  <%- include('./partials/footer') %>
    <script>
      function togglePass(id, btn) {
        const input = document.getElementById(id);
        if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
        else { input.type = 'password'; btn.textContent = '👁'; }
      }

      function switchLoginTab(tab) {
        if (tab === 'password') {
          document.getElementById('passwordForm').style.display = 'block';
          document.getElementById('otpForm').style.display = 'none';
          document.getElementById('tabPassword').style.borderBottom = '2px solid #2c7a4b';
          document.getElementById('tabPassword').style.color = '#2c7a4b';
          document.getElementById('tabOTP').style.borderBottom = 'none';
          document.getElementById('tabOTP').style.color = 'var(--gray-500)';
        } else {
          document.getElementById('passwordForm').style.display = 'none';
          document.getElementById('otpForm').style.display = 'block';
          document.getElementById('tabOTP').style.borderBottom = '2px solid #2c7a4b';
          document.getElementById('tabOTP').style.color = '#2c7a4b';
          document.getElementById('tabPassword').style.borderBottom = 'none';
          document.getElementById('tabPassword').style.color = 'var(--gray-500)';
        }
      }

      async function sendLoginOTP() {
        const phoneInput = document.getElementById('loginPhone');
        const phone = phoneInput.value.trim();
        if (!phone || phone.length < 10) {
            alert("Please enter a valid mobile number.");
            return;
        }

        const btn = document.getElementById('sendLoginOtpBtn');
        btn.disabled = true;
        btn.innerText = "Sending...";

        try {
            const response = await fetch('/auth/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, context: 'login' })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('loginOtpGroup').style.display = 'block';
                document.getElementById('submitOtpBtn').style.display = 'block';
                document.getElementById('loginOtp').required = true;
                
                document.getElementById('loginOtpMessage').innerText = data.message;
                document.getElementById('loginOtpMessage').style.color = '#2c7a4b';
                btn.innerText = "Sent";
            } else {
                btn.disabled = false;
                btn.innerText = "Send OTP";
                alert(data.message || "Failed to send OTP.");
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerText = "Send OTP";
            alert("An error occurred while sending OTP.");
        }
      }

      function validateOtpForm() {
        const otp = document.getElementById('loginOtp');
        if (otp && otp.required && !otp.value.trim()) {
            alert('Please enter the OTP!');
            return false;
        }
        return true;
      }
    </script>
