<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1>Reset Password</h1>
        <p>Enter your new password below</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/reset-password" novalidate>
        <input type="hidden" name="token" value="<%= token %>">

        <div class="form-group">
          <label for="password">New Password</label>
          <div class="input-group">
            <input type="password" id="password" name="password" class="form-control"
                   required placeholder="••••••••" autocomplete="new-password"
                   oninput="checkPassword(this.value)">
            <button type="button" class="toggle-password" onclick="togglePassword('password')">👁</button>
          </div>
          <ul class="password-hints" id="passwordHints">
            <li id="hint-length" class="hint-fail">At least 6 characters</li>
            <li id="hint-upper" class="hint-fail">One uppercase letter</li>
            <li id="hint-number" class="hint-fail">One number</li>
          </ul>
        </div>

        <div class="form-group">
          <label for="confirm_password">Confirm New Password</label>
          <div class="input-group">
            <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                   required placeholder="••••••••" autocomplete="new-password">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">👁</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script>
    function togglePassword(id) {
      const el = document.getElementById(id);
      el.type = el.type === 'password' ? 'text' : 'password';
    }
    function checkPassword(val) {
      document.getElementById('hint-length').className = val.length >= 6 ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-upper').className = /[A-Z]/.test(val) ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-number').className = /[0-9]/.test(val) ? 'hint-pass' : 'hint-fail';
    }
  </script>
</body>
</html>
