<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="auth-section">
    <div class="auth-container" style="justify-content: center;">
      <div class="auth-card" style="max-width: 500px; flex: none;">
        <h2>Reset Password</h2>
        <p style="text-align:center; color:var(--gray-500); margin-top:-20px; margin-bottom:28px; font-size:15px;">
          Create a new password for your account.
        </p>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>

        <form method="POST" action="/auth/reset-password" novalidate>
          <input type="hidden" name="token" value="<%= token %>">

          <div class="form-group">
            <label for="password" class="form-label">New Password</label>
            <div class="password-wrap">
              <input type="password" id="password" name="password" class="form-input"
                     required placeholder="••••••••" autocomplete="new-password"
                     oninput="checkPassword(this.value)">
              <span class="toggle-pass" onclick="togglePassword('password')">👁</span>
            </div>
            <ul class="password-hints" id="passwordHints">
              <li id="hint-length" class="hint-fail">At least 6 characters</li>
              <li id="hint-upper" class="hint-fail">One uppercase letter</li>
              <li id="hint-number" class="hint-fail">One number</li>
            </ul>
          </div>

          <div class="form-group">
            <label for="confirm_password" class="form-label">Confirm New Password</label>
            <div class="password-wrap">
              <input type="password" id="confirm_password" name="confirm_password" class="form-input"
                     required placeholder="••••••••" autocomplete="new-password">
              <span class="toggle-pass" onclick="togglePassword('confirm_password')">👁</span>
            </div>
          </div>

          <button type="submit" class="auth-btn">Reset Password</button>
        </form>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script>
    function togglePassword(id) {
      const el = document.getElementById(id);
      el.type = el.type === 'password' ? 'text' : 'password';
    }
    function checkPassword(val) {
      document.getElementById('hint-length').className = val.length >= 6 ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-upper').className = /[A-Z]/.test(val) ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-number').className = /[0-9]/.test(val) ? 'hint-pass' : 'hint-fail';
    }
  </script>
</body>
</html>
