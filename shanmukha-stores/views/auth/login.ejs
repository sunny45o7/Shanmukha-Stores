<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="auth-section">
    <div class="auth-container">
      <div class="auth-left">
        <h1>Welcome Back</h1>
        <p>Sign in to access your luxury shopping experience, view your orders, and manage your profile.</p>
        <div class="auth-benefit">
          <span class="icon">✨</span>
          <span>Exclusive access to premium products</span>
        </div>
        <div class="auth-benefit">
          <span class="icon">📦</span>
          <span>Fast and secure delivery</span>
        </div>
        <div class="auth-benefit">
          <span class="icon">💎</span>
          <span>Uncompromised quality and service</span>
        </div>
      </div>

      <div class="auth-card">
        <h2>Sign In</h2>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
          <% if (error.includes('verify your email')) { %>
            <form method="POST" action="/auth/resend-verification" style="text-align:center; margin-bottom: 16px;">
              <input type="hidden" name="email" id="resendEmail">
              <button type="submit" style="border:none;background:none;font-weight:600;cursor:pointer;color:var(--black);" onclick="document.getElementById('resendEmail').value = document.getElementById('loginInput').value;">
                📧 Resend verification email
              </button>
            </form>
          <% } %>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success"><%= success %></div>
        <% } %>

        <form method="POST" action="/auth/login" novalidate>
          <div class="form-group">
            <label for="loginInput" class="form-label">Email or Mobile Number *</label>
            <input type="text" id="loginInput" name="login_id" class="form-input" required
                   placeholder="Email or Mobile Number">
          </div>

          <div class="form-group">
            <label for="password" class="form-label" style="display:flex;justify-content:space-between;">
              <span>Password</span>
              <a href="/auth/forgot-password" style="text-transform:none;letter-spacing:normal;font-weight:400;color:var(--gray-500);">Forgot password?</a>
            </label>
            <div class="password-wrap">
              <input type="password" id="password" name="password" class="form-input" required
                     placeholder="Enter your password" autocomplete="current-password">
              <span class="toggle-pass" onclick="togglePassword('password')">👁</span>
            </div>
          </div>

          <button type="submit" class="auth-btn">Sign In</button>
        </form>

        <div style="margin-top:24px;text-align:center;font-size:14px;color:var(--gray-500);">
          Don't have an account? <a href="/auth/register" style="color:var(--black);font-weight:600;">Create one</a>
        </div>

        <div class="auth-divider">
          <span>OR</span>
        </div>

        <div class="social-auth-wrap">
          <a href="/auth/google" class="google-auth-btn" id="googleLoginBtnAuth">
            <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.27 21.39 7.35 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.16 0 9.98 0 12s.45 3.84 1.25 5.42l4.03-3.15z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.27 2.61 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Sign in with Google</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script>
    function togglePassword(id) {
      const input = document.getElementById(id);
      input.type = input.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>
