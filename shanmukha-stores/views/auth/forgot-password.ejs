<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="auth-section">
    <div class="auth-container" style="justify-content: center;">
      <!-- Optional: Add auth-left if you want split screen here too. Otherwise just center the card -->
      <div class="auth-card" style="max-width: 500px; flex: none;">
        <h2>Forgot Password?</h2>
        <p style="text-align:center; color:var(--gray-500); margin-top:-20px; margin-bottom:28px; font-size:15px;">
          Enter your email and we'll send you a secure reset link.
        </p>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success"><%= success %></div>
        <% } %>

        <div style="display:flex; gap:16px; margin-bottom:24px; border-bottom:1px solid #eee;">
          <button type="button" class="tab-btn" id="tabEmail" onclick="switchTab('email')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; cursor:pointer; border-bottom:2px solid #2c7a4b; color:#2c7a4b;">Email Reset</button>
          <button type="button" class="tab-btn" id="tabMobile" onclick="switchTab('mobile')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; cursor:pointer; color:var(--gray-500);">Mobile Reset</button>
        </div>

        <form method="POST" action="/auth/forgot-password" id="emailForm">
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-input"
                   required placeholder="you@example.com" autocomplete="email">
          </div>
          <button type="submit" class="auth-btn">Send Reset Link</button>
        </form>

        <form method="POST" action="/auth/reset-password-otp" id="mobileForm" style="display:none;" onsubmit="return validateMobileForm()">
          <div class="form-group">
            <label for="phone" class="form-label">Mobile Number</label>
            <div style="display: flex; gap: 8px;">
                <input type="tel" id="phone" name="phone" class="form-input" required autocomplete="tel" style="flex: 1;">
                <button type="button" class="auth-btn" id="sendOtpBtn" onclick="sendOTP()" style="width: auto; padding: 0 16px; font-size: 14px;">Send OTP</button>
            </div>
          </div>
          
          <div class="form-group" id="otpGroup" style="display: none;">
            <label class="form-label">OTP</label>
            <input type="text" name="otp" id="resetOtp" class="form-input" placeholder="Enter OTP">
            <small id="otpMessage" style="color: #2c7a4b; display: block; margin-top: 4px; font-size: 12px;"></small>
          </div>

          <div class="form-group" id="newPassGroup" style="display: none;">
            <label class="form-label">New Password</label>
            <div class="password-wrap" style="margin-bottom:12px;">
              <input type="password" name="password" id="resetPass" class="form-input" placeholder="••••••••">
              <span class="toggle-pass" onclick="togglePass('resetPass', this)">👁</span>
            </div>
            
            <label class="form-label">Confirm Password</label>
            <div class="password-wrap">
              <input type="password" name="confirm_password" id="resetPassConfirm" class="form-input" placeholder="••••••••">
              <span class="toggle-pass" onclick="togglePass('resetPassConfirm', this)">👁</span>
            </div>
          </div>

          <button type="submit" class="auth-btn" id="submitMobileBtn" style="display:none; margin-top:16px;">Reset Password</button>
        </form>

        <div style="margin-top:24px;text-align:center;font-size:14px;">
          <a href="/auth/login" style="color:var(--gray-500);font-weight:500;">← Back to Login</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <script>
    function switchTab(tab) {
      if (tab === 'email') {
        document.getElementById('emailForm').style.display = 'block';
        document.getElementById('mobileForm').style.display = 'none';
        document.getElementById('tabEmail').style.borderBottom = '2px solid #2c7a4b';
        document.getElementById('tabEmail').style.color = '#2c7a4b';
        document.getElementById('tabMobile').style.borderBottom = 'none';
        document.getElementById('tabMobile').style.color = 'var(--gray-500)';
      } else {
        document.getElementById('emailForm').style.display = 'none';
        document.getElementById('mobileForm').style.display = 'block';
        document.getElementById('tabMobile').style.borderBottom = '2px solid #2c7a4b';
        document.getElementById('tabMobile').style.color = '#2c7a4b';
        document.getElementById('tabEmail').style.borderBottom = 'none';
        document.getElementById('tabEmail').style.color = 'var(--gray-500)';
      }
    }

    function togglePass(id, btn) {
        const input = document.getElementById(id);
        if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
        else { input.type = 'password'; btn.textContent = '👁'; }
    }

    async function sendOTP() {
        const phoneInput = document.getElementById('phone');
        const phone = phoneInput.value.trim();
        if (!phone || phone.length < 10) {
            alert("Please enter a valid mobile number.");
            return;
        }

        const btn = document.getElementById('sendOtpBtn');
        btn.disabled = true;
        btn.innerText = "Sending...";

        try {
            const response = await fetch('/auth/send-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phone, context: 'reset' })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('otpGroup').style.display = 'block';
                document.getElementById('newPassGroup').style.display = 'block';
                document.getElementById('submitMobileBtn').style.display = 'block';
                document.getElementById('resetOtp').required = true;
                document.getElementById('resetPass').required = true;
                document.getElementById('resetPassConfirm').required = true;
                
                document.getElementById('otpMessage').innerText = data.message;
                document.getElementById('otpMessage').style.color = '#2c7a4b';
                btn.innerText = "Sent";
            } else {
                btn.disabled = false;
                btn.innerText = "Send OTP";
                alert(data.message || "Failed to send OTP.");
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerText = "Send OTP";
            alert("An error occurred while sending OTP.");
        }
    }

    function validateMobileForm() {
        const pwd = document.getElementById('resetPass').value;
        const cpwd = document.getElementById('resetPassConfirm').value;
        if (pwd !== cpwd) {
            alert('Passwords do not match!');
            return false;
        }
        const otp = document.getElementById('resetOtp');
        if (otp && otp.required && !otp.value.trim()) {
            alert('Please enter the OTP!');
            return false;
        }
        return true;
    }
  </script>
</body>
</html>
