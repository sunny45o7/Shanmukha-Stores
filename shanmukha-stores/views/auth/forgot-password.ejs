<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <section class="auth-section">
    <div class="auth-container" style="justify-content: center;">
      <!-- Optional: Add auth-left if you want split screen here too. Otherwise just center the card -->
      <div class="auth-card" style="max-width: 500px; flex: none;">
        <h2>Forgot Password?</h2>
        <p style="text-align:center; color:var(--gray-500); margin-top:-20px; margin-bottom:28px; font-size:15px;">
          Enter your email and we'll send you a secure reset link.
        </p>

        <% if (error) { %>
          <div class="auth-alert error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="auth-alert success"><%= success %></div>
        <% } %>

        <form method="POST" action="/auth/forgot-password">
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-input"
                   required placeholder="you@example.com" autocomplete="email">
          </div>
          <button type="submit" class="auth-btn">Send Reset Link</button>
        </form>

        <div style="margin-top:24px;text-align:center;font-size:14px;">
          <a href="/auth/login" style="color:var(--gray-500);font-weight:500;">← Back to Login</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>
</body>
</html>
