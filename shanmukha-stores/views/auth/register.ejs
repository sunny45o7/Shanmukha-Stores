<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Shanmukha Stores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1>Create Account</h1>
        <p>Join Shanmukha Stores today</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/auth/register" novalidate>
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" class="form-control" required
                 value="<%= typeof old !== 'undefined' ? old.name || '' : '' %>"
                 placeholder="Your full name">
        </div>

        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" class="form-control" required
                 value="<%= typeof old !== 'undefined' ? old.email || '' : '' %>"
                 placeholder="you@example.com" autocomplete="email">
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" class="form-control"
                 value="<%= typeof old !== 'undefined' ? old.phone || '' : '' %>"
                 placeholder="+91 9999999999">
        </div>

        <div class="form-group">
          <label for="password">Password *</label>
          <div class="input-group">
            <input type="password" id="password" name="password" class="form-control" required
                   placeholder="••••••••" autocomplete="new-password"
                   oninput="checkPassword(this.value)">
            <button type="button" class="toggle-password" onclick="togglePassword('password')">👁</button>
          </div>
          <div class="password-strength" id="strengthBar"></div>
          <ul class="password-hints" id="passwordHints">
            <li id="hint-length" class="hint-fail">At least 6 characters</li>
            <li id="hint-upper" class="hint-fail">One uppercase letter</li>
            <li id="hint-number" class="hint-fail">One number</li>
          </ul>
        </div>

        <div class="form-group">
          <label for="confirm_password">Confirm Password *</label>
          <div class="input-group">
            <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                   required placeholder="••••••••" autocomplete="new-password">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">👁</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create Account</button>
        <p class="text-sm text-center mt-2" style="color:#666;">
          By registering, you'll receive a verification email.
        </p>
      </form>

      <div class="auth-footer">
        <p>Already have an account? <a href="/auth/login">Sign in</a></p>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script>
    function togglePassword(id) {
      const input = document.getElementById(id);
      input.type = input.type === 'password' ? 'text' : 'password';
    }
    function checkPassword(val) {
      document.getElementById('hint-length').className = val.length >= 6 ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-upper').className = /[A-Z]/.test(val) ? 'hint-pass' : 'hint-fail';
      document.getElementById('hint-number').className = /[0-9]/.test(val) ? 'hint-pass' : 'hint-fail';
    }
  </script>
</body>
</html>
