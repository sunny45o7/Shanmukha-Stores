<%- include('./partials/navbar') %>

<section class="order-confirmation-section">
  <div class="order-confirmation-head">
    <div class="checkout-steps confirmation-steps">
      <span class="step done">1. Cart</span>
      <span class="step-divider">&gt;</span>
      <span class="step done">2. Checkout</span>
      <span class="step-divider">&gt;</span>
      <span class="step active">3. Confirmation</span>
    </div>
    <div class="steps-track confirmation-track" aria-hidden="true"><span style="width:100%"></span></div>
    <div class="order-confirmation-icon">OK</div>
    <p class="order-confirmation-kicker">Order Confirmed</p>
    <h1>Thank you for your purchase</h1>
    <p class="order-confirmation-subtitle">
      Your order has been placed successfully and our team will start processing it right away.
    </p>
    <% if (typeof warning !== 'undefined' && warning) { %>
      <div class="alert alert-warning" style="margin-top: 16px; display: inline-block; text-align: left; max-width: 600px; color: #856404; background-color: #fff3cd; border: 1px solid #ffeeba; padding: 12px 20px; border-radius: 6px;">
        <strong>Notice:</strong> <%= warning %>
      </div>
    <% } %>
  </div>

  <% if (typeof upiDetails !== 'undefined' && upiDetails) { %>
    <div class="whatsapp-pay-hero-card" id="whatsappPayCard">
      <div class="pay-hero-top-strip">
        <div class="pay-hero-badge">
          <span class="pulse-dot"></span> WhatsApp Pay &bull; Complete Payment via UPI
        </div>
        <div class="pay-order-tag">Order #<%= order.id %></div>
      </div>
      
      <div class="pay-hero-grid">
        <!-- QR Section -->
        <div class="pay-qr-side">
          <div class="pay-qr-box">
            <% if (upiDetails.qrCodeDataUrl) { %>
              <img src="<%= upiDetails.qrCodeDataUrl %>" alt="Scan to pay ₹<%= upiDetails.amount %>" class="dynamic-upi-qr" id="dynamicUpiQrImg" />
            <% } %>
            <div class="pay-qr-scan-text">
              Scan with <strong>GPay, PhonePe, Paytm</strong>
            </div>
          </div>
          <div class="pay-qr-amount-chip">
            Payable: <strong>&#8377;<%= Number(upiDetails.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong>
          </div>
        </div>

        <!-- Instructions & Action Side -->
        <div class="pay-info-side">
          <div class="pay-headline">
            <h3>Complete Your Order Payment</h3>
            <p>Scan the dynamic QR code on the left with any UPI app, or tap below to pay directly.</p>
          </div>

          <div class="pay-upi-row">
            <span class="upi-tag">UPI ID:</span>
            <code class="upi-address" id="merchantUpiText"><%= upiDetails.upiId %></code>
            <button type="button" class="btn-copy-upi" onclick="copyMerchantUpi()" id="copyUpiBtn">
              📋 Copy
            </button>
          </div>

          <!-- Mobile 1-Tap Pay Button -->
          <a href="<%= upiDetails.upiUri %>" class="btn-upi-instant-pay">
            <span>⚡ Tap to Pay &#8377;<%= Number(upiDetails.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> with UPI</span>
          </a>

          <!-- Screenshot Alert Notice -->
          <div class="pay-screenshot-box">
            <div class="screenshot-icon">📸</div>
            <div class="screenshot-content">
              <h4>Please Send Payment Screenshot</h4>
              <p>After paying, please share your <strong>screenshot</strong> or <strong>UTR / Reference Number</strong> on WhatsApp to verify and dispatch your order immediately.</p>
            </div>
          </div>

          <!-- WhatsApp Chat Button -->
          <a href="<%= upiDetails.whatsAppScreenshotUrl %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-screenshot">
            <span class="wa-icon">💬</span>
            <span>Send Screenshot on WhatsApp (+91 <%= upiDetails.whatsAppPhone.replace(/^91/, '') %>)</span>
          </a>
        </div>
      </div>
    </div>
  <% } %>

  <div class="order-confirmation-grid">
    <article class="order-confirmation-card">
      <div class="card-header-luxury">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="header-icon-badge">📋</span>
          <h2>Order Summary</h2>
        </div>
        <span class="order-id-chip">#<%= order.id %></span>
      </div>
      <div class="order-confirmation-rows">
        <div class="order-confirmation-row">
          <span class="row-label">Order Status</span>
          <span class="status-pill status-<%= String(order.status || 'pending').toLowerCase() %>">
            <span class="status-dot"></span> <%= order.status %>
          </span>
        </div>
        <div class="order-confirmation-row">
          <span class="row-label">Items Subtotal</span>
          <strong>&#8377;<%= Number(typeof itemsSubtotal !== 'undefined' ? itemsSubtotal : order.total_amount).toLocaleString('en-IN') %></strong>
        </div>
        <% if (typeof couponDiscount !== 'undefined' && Number(couponDiscount) > 0) { %>
          <div class="order-confirmation-row discount-row">
            <span class="row-label">Coupon Discount<% if (couponCode) { %> (<%= couponCode %>)<% } %></span>
            <strong class="discount-val">-&#8377;<%= Number(couponDiscount).toLocaleString('en-IN') %></strong>
          </div>
        <% } %>
        <div class="order-confirmation-row">
          <span class="row-label">Delivery</span>
          <span style="background: #dcfce7; color: #15803d; font-weight: 700; font-size: 11px; padding: 2px 8px; border-radius: 999px;">FREE</span>
        </div>
        <div class="order-confirmation-row">
          <span class="row-label">Payment Method</span>
          <span class="payment-method-tag"><%= (order.payment_method || 'COD').toUpperCase() %></span>
        </div>
        <% if (order.addr_name) { %>
          <div class="order-confirmation-row delivery-row">
            <span class="row-label">Delivery Address</span>
            <span class="delivery-address"><span class="geo-icon">📍</span> <strong><%= order.addr_name %>, <%= order.city %></strong></span>
          </div>
        <% } else if (order.address_snapshot) { %>
          <div class="order-confirmation-row delivery-row">
            <span class="row-label">Delivery Address</span>
            <span class="delivery-address"><span class="geo-icon">📍</span> <strong><%= order.address_snapshot %></strong></span>
          </div>
        <% } %>

        <div class="order-summary-total-box">
          <div>
            <span class="total-box-label">Total Amount</span>
            <span class="total-box-sub">Inclusive of all taxes</span>
          </div>
          <strong class="total-box-val">&#8377;<%= Number(order.total_amount).toLocaleString('en-IN') %></strong>
        </div>
      </div>
    </article>

    <article class="order-confirmation-card">
      <div class="card-header-luxury">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="header-icon-badge">✨</span>
          <h2>What Happens Next</h2>
        </div>
      </div>
      <div class="luxury-steps-timeline">
        <div class="timeline-step">
          <div class="step-num-bubble">1</div>
          <div class="step-body">
            <div class="step-title">Order Verified &amp; Packed</div>
            <div class="step-desc">We handpick and hermetically pack your organic items with supreme freshness.</div>
          </div>
        </div>
        <div class="timeline-step">
          <div class="step-num-bubble">2</div>
          <div class="step-body">
            <div class="step-title">Express Dispatch</div>
            <div class="step-desc">Your order is handed over to our delivery partner with live SMS and WhatsApp status alerts.</div>
          </div>
        </div>
        <div class="timeline-step">
          <div class="step-num-bubble">3</div>
          <div class="step-body">
            <div class="step-title">Doorstep Handover</div>
            <div class="step-desc">Our delivery partner will reach out to you directly upon arrival.</div>
          </div>
        </div>
      </div>
      <div class="order-confirmation-mail-note">
        <span class="mail-icon">✉️</span>
        <span>A detailed receipt has been sent to your registered email &amp; phone.</span>
      </div>
    </article>
  </div>

  <% if (typeof items !== 'undefined' && items.length > 0) { %>
    <article class="order-confirmation-card order-confirmation-items">
      <div class="card-header-luxury">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="header-icon-badge">📦</span>
          <h2>Items in Your Order (<%= items.reduce((s, i) => s + i.quantity, 0) %>)</h2>
        </div>
      </div>
      <div class="confirmation-items-grid">
        <% items.forEach(item => { %>
          <div class="confirmation-item-card">
            <div class="confirmation-item-img-wrap">
              <img src="<%= item.image || '/images/placeholder.png' %>" alt="<%= item.name %>" class="confirmation-item-img" onerror="this.src='/images/placeholder.png'">
              <span class="confirmation-qty-pill">x<%= item.quantity %></span>
            </div>
            <div class="confirmation-item-details">
              <h4 class="confirmation-item-title"><%= item.name %></h4>
              <% if (item.selected_weight) { %>
                <span class="confirmation-weight-tag"><%= item.selected_weight %></span>
              <% } %>
              <div class="confirmation-item-pricing">
                <span class="unit-price">&#8377;<%= Number(item.price).toLocaleString('en-IN') %> each</span>
                <span class="line-subtotal">&#8377;<%= Number(item.price * item.quantity).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </article>
  <% } %>

  <% if (typeof suggestedProducts !== 'undefined' && suggestedProducts.length > 0) { %>
    <article class="order-confirmation-card order-confirmation-suggestions" style="margin-top: 32px; padding: 24px;">
      <h2 style="margin-bottom: 20px; font-size: 22px; text-align: center;">Recommended For You</h2>
      <div class="products-grid">
        <% suggestedProducts.forEach((p) => { %>
          <div class="product-card">
            <div class="product-image">
              <a href="/products/<%= p.id %>">
                <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" onerror="this.src='/images/placeholder.png'">
              </a>

              <% if (p.stock === 0) { %>
                <span class="product-badge sale">Sold Out</span>
              <% } %>

              <form action="/wishlist/toggle/<%= p.id %>" method="POST" class="wishlist-toggle-form wishlist-form-inline" data-product-id="<%= p.id %>">
                <button type="submit" class="wishlist-btn" title="Wishlist">♡</button>
              </form>
            </div>

            <div class="product-info">
              <p class="product-category-tag"><%= p.category_name || 'Grocery' %></p>
              <h3 class="product-name"><a href="/products/<%= p.id %>"><%= p.name %></a></h3>
              
              <div class="product-rating small">
                <span class="stars" style="--rating: <%= p.average_rating || 0 %>;"></span>
                <% if (p.review_count > 0) { %>
                  <span class="rating-text">(<%= p.review_count %>)</span>
                <% } %>
              </div>

              <p class="product-price">&#8377;<%= Number(p.effective_price || p.price).toLocaleString('en-IN') %>
                <% if (p.price_type === 'kg') { %>
                  <span class="price-unit-note">per kg</span>
                <% } else { %>
                  <span class="price-unit-note">per unit</span>
                <% } %>
              </p>
              <% if (p.stock === 0) { %>
                <div class="out-of-stock-label">Out of Stock</div>
              <% } else { %>
                <form action="/cart/add/<%= p.id %>" method="POST">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="add-cart-btn">Add to Cart</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </article>
  <% } %>

  <div class="order-confirmation-actions">
    <a href="/addresses?from=checkout" class="btn-secondary">Add New Address</a>
    <a href="/orders" class="btn-primary">View My Orders</a>
    <a href="/products" class="btn-secondary">Continue Shopping</a>
  </div>
</section>

<div class="order-success-popup" id="orderSuccessPopup" aria-hidden="true">
  <div class="order-success-card">
    <button type="button" class="order-success-close" id="orderSuccessClose" aria-label="Close">x</button>
    <div class="order-success-badge">Success</div>
    <h3>Congratulations!</h3>
    <p>Your order #<%= order.id %> has been placed successfully.</p>
    <div class="order-success-meta">We have started processing your order. Arriving soon.</div>
  </div>
</div>

<style>
  .order-confirmation-section {
    max-width: 1160px;
    margin: 0 auto;
    padding: 36px 20px 54px;
  }

  .order-confirmation-head {
    text-align: center;
    margin-bottom: 24px;
  }

  .confirmation-steps {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .confirmation-steps .step {
    font-size: 12px;
    font-weight: 600;
    color: #6b6b6b;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #fff;
  }

  .confirmation-steps .step.done {
    color: #fff;
    background: linear-gradient(90deg, #1c4a30 0%, #2d5a3f 100%);
    border-color: transparent;
  }

  .confirmation-steps .step.active {
    color: #1c4a30;
    border-color: rgba(28, 74, 48, 0.34);
    background: rgba(28, 74, 48, 0.1);
    box-shadow: 0 0 0 5px rgba(28, 74, 48, 0.08);
    animation: stepPulse 1.5s ease infinite;
  }

  .step-divider {
    color: #999;
    font-size: 12px;
    font-weight: 700;
  }

  .confirmation-track {
    width: min(420px, 100%);
    margin: 0 auto 16px;
    height: 8px;
    border-radius: 999px;
    background: #ececec;
    overflow: hidden;
  }

  .confirmation-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #1c4a30 0%, #d4af37 100%);
    position: relative;
  }

  .confirmation-track span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.52), transparent);
    animation: completeSweep 1.8s ease-in-out infinite;
  }

  .order-confirmation-head .order-confirmation-icon {
    width: 82px;
    height: 82px;
    margin: 0 auto 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    color: #fff;
    background: linear-gradient(135deg, #1c4a30 0%, #3f7a59 100%);
    box-shadow: 0 18px 34px rgba(28, 74, 48, 0.26);
  }

  .order-confirmation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 22px;
    margin-bottom: 26px;
  }

  .order-confirmation-card {
    border-radius: 20px;
    border: 1px solid rgba(28, 74, 48, 0.12);
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .card-header-luxury {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .header-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(28, 74, 48, 0.08);
    font-size: 18px;
  }

  .card-header-luxury h2 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    color: #111;
    margin: 0;
  }

  .order-confirmation-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .order-confirmation-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.07);
    font-size: 14px;
  }

  .order-confirmation-row:last-child {
    border-bottom: none;
  }

  .order-confirmation-row .row-label {
    color: #555;
    font-weight: 500;
  }

  .order-id-chip {
    font-family: monospace;
    font-size: 14px;
    font-weight: 700;
    background: rgba(28, 74, 48, 0.08);
    color: var(--emerald);
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .status-pill.status-pending {
    background: #fff8e6;
    color: #b45309;
    border: 1px solid #fef3c7;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
  }

  .total-row {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 2px solid rgba(28, 74, 48, 0.15);
  }

  .total-row .row-label {
    font-size: 16px;
    font-weight: 700;
    color: #111;
  }

  .total-val {
    font-size: 20px;
    font-weight: 800;
    color: var(--emerald);
  }

  .discount-row {
    color: #16a34a;
  }

  .discount-val {
    color: #16a34a;
  }

  .payment-method-tag {
    font-size: 12px;
    font-weight: 700;
    background: #f3f4f6;
    color: #374151;
    padding: 3px 9px;
    border-radius: 6px;
  }

  .delivery-address {
    font-size: 13px;
    text-align: right;
    max-width: 60%;
    color: #222;
  }

  .order-summary-total-box {
    margin-top: 14px;
    padding: 14px 18px;
    background: linear-gradient(135deg, #f7faf8 0%, #edf5f0 100%);
    border: 1.5px solid rgba(28, 74, 48, 0.18);
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .total-box-label {
    display: block;
    font-size: 14.5px;
    font-weight: 700;
    color: #1c4a30;
  }

  .total-box-sub {
    display: block;
    font-size: 11px;
    color: #6b7280;
  }

  .total-box-val {
    font-size: 22px;
    font-weight: 800;
    color: #1c4a30;
  }

  /* ── ITEMS IN ORDER CARDS ── */
  .order-confirmation-items {
    margin-top: 24px;
  }

  .confirmation-items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 14px;
  }

  .confirmation-item-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fbfdfb;
    border: 1px solid rgba(28, 74, 48, 0.1);
    border-radius: 14px;
    padding: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .confirmation-item-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(28, 74, 48, 0.08);
  }

  .confirmation-item-img-wrap {
    position: relative;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  .confirmation-item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(28, 74, 48, 0.12);
    background: #fff;
  }

  .confirmation-qty-pill {
    position: absolute;
    bottom: -4px;
    right: -4px;
    background: #1c4a30;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1.5px solid #fff;
  }

  .confirmation-item-details {
    flex: 1;
    min-width: 0;
  }

  .confirmation-item-title {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 3px 0;
    line-height: 1.25;
  }

  .confirmation-weight-tag {
    display: inline-block;
    font-size: 11px;
    color: #78350f;
    background: #fef3c7;
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .confirmation-item-pricing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }

  .confirmation-item-pricing .unit-price {
    color: #6b7280;
    font-size: 12px;
  }

  .confirmation-item-pricing .line-subtotal {
    font-weight: 700;
    color: #1c4a30;
    font-size: 14.5px;
  }

  /* ── TIMELINE WHAT HAPPENS NEXT ── */
  .luxury-steps-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 0;
  }

  .timeline-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .step-num-bubble {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1c4a30 0%, #2d5a3f 100%);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(28, 74, 48, 0.2);
  }

  .step-body {
    flex: 1;
  }

  .step-title {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    margin-bottom: 2px;
  }

  .step-desc {
    font-size: 13px;
    color: #666;
    line-height: 1.45;
  }

  .order-confirmation-mail-note {
    margin-top: 18px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(28, 74, 48, 0.05);
    border: 1px solid rgba(28, 74, 48, 0.12);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--emerald);
    font-weight: 500;
  }

  .order-confirmation-actions {
    margin-top: 24px;
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .order-confirmation-actions .btn-primary,
  .order-confirmation-actions .btn-secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .order-success-popup {
    position: fixed;
    inset: 0;
    z-index: 1400;
    background: rgba(7, 7, 7, 0.38);
    backdrop-filter: blur(4px);
    display: flex;
