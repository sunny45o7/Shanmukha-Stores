<script>
  function copyMerchantUpi() {
    const el = document.getElementById('merchantUpiText');
    const btn = document.getElementById('copyUpiBtn');
    if (!el) return;
    const text = el.innerText.trim();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = '✅ Copied!';
          btn.style.background = '#10b981';
          btn.style.color = '#fff';
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.style.background = '';
            btn.style.color = '';
          }, 2000);
        }
      }).catch(() => { prompt("Copy UPI ID:", text); });
    } else {
      prompt("Copy UPI ID:", text);
    }
  }

  (function () {
    const popup = document.getElementById('orderSuccessPopup');
    const closeBtn = document.getElementById('orderSuccessClose');
    if (!popup) return;

    const orderId = '<%= order.id %>';
    const key = `orderCongratsShown_${orderId}`;
    const shown = sessionStorage.getItem(key);

    if (!shown) {
      setTimeout(() => {
        popup.classList.add('show');
        popup.setAttribute('aria-hidden', 'false');
      }, 250);
      sessionStorage.setItem(key, '1');
    }

    function closePopup() {
      popup.classList.remove('show');
      popup.setAttribute('aria-hidden', 'true');
    }

    closeBtn?.addEventListener('click', closePopup);

    setTimeout(closePopup, 5200);
  })();

  // Instant optimistic wishlist toggle
  document.querySelectorAll('.wishlist-toggle-form').forEach((form) => {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const productId = this.dataset.productId;
      const btn = this.querySelector('button');
      const wasActive = btn.classList.contains('active');
      const willBeActive = !wasActive;

      btn.classList.toggle('active', willBeActive);
      btn.classList.add('animating');
      setTimeout(() => btn.classList.remove('animating'), 450);
      btn.textContent = willBeActive ? '♥' : '♡';

      try {
        const res = await fetch(`/wishlist/toggle/${productId}`, {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          btn.classList.toggle('active', wasActive);
          btn.textContent = wasActive ? '♥' : '♡';
          if (data && data.redirect) window.location.href = data.redirect;
          return;
        }
        const serverActive = data.status === 'added';
        btn.classList.toggle('active', serverActive);
        btn.textContent = serverActive ? '♥' : '♡';
      } catch (err) {
        btn.classList.toggle('active', wasActive);
        btn.textContent = wasActive ? '♥' : '♡';
      }
    });
  });
</script>

