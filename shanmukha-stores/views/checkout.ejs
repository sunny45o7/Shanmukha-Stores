<%- include('./partials/navbar') %>

  <div class="container py-40 no-print checkout-modern">
    <div class="page-header checkout-head">
      <h1>Checkout</h1>
      <div class="checkout-steps">
        <a href="/cart" class="step done step-link" title="Back to Cart">1. Cart</a>
        <span class="step-divider">&gt;</span>
        <span class="step active">2. Checkout</span>
        <span class="step-divider">&gt;</span>
        <span class="step">3. Confirmation</span>
      </div>
      <div class="steps-track" aria-hidden="true"><span style="width:66%"></span></div>
    </div>

    <% if (typeof error !=='undefined' && error) { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof stockWarnings !=='undefined' && stockWarnings && stockWarnings.length> 0) { %>
          <div class="alert alert-warning">
            <strong>Stock warning:</strong>
            <ul style="margin:4px 0 0 20px;">
              <% stockWarnings.forEach(w=> { %><li>
                  <%= w %>
                </li>
                <% }) %>
            </ul>
            <a href="/cart">Go back to cart to fix</a>
          </div>
          <% } %>

            <form method="POST" action="/orders/place" id="checkoutForm">
              <input type="hidden" name="transaction_id" id="transactionIdInput" value="">
              <div class="checkout-grid">

                <div>
                  <div class="card mb-24">
                    <div class="card-header">
                      <div class="card-head-row">
                        <h2>Delivery Address</h2>
                        <button type="button" class="btn btn-outline btn-sm" onclick="openAddAddressModal()">Add New Address</button>
                      </div>
                    </div>
                    <div class="card-body">
                      <% var savedAddresses=(typeof addresses !=='undefined' && Array.isArray(addresses)) ? addresses :
                        []; %>

                        <% if (savedAddresses.length> 0) { %>
                          <div class="address-selector">
                            <% savedAddresses.forEach((addr, i)=> { %>
                              <label class="address-option">
                                <input type="radio" name="address_id" value="<%= addr.id %>" <%=i===0 ? 'checked' : ''
                                  %> onchange="toggleNewAddress(false)">
                                <div class="address-option-body">
                                  <% if (addr.is_default) { %><span class="badge badge-success badge-sm">Default</span>
                                    <% } %>
                                      <strong>
                                        <%= addr.full_name %>
                                      </strong>
                                      <% if (addr.phone) { %><span class="text-muted"> - <%= addr.phone %></span>
                                        <% } %>
                                          <p class="text-sm">
                                            <%= addr.address_line %>, <%= addr.city %>, <%= addr.state %> - <%=
                                                    addr.pincode %>
                                          </p>
                                </div>
                              </label>
                              <% }) %>
                          </div>
                          <% } else { %>
                            <input type="hidden" name="address_id" value="new">
                            <p class="text-muted mb-16">No saved addresses. Please enter a delivery address below.</p>
                            <% } %>

                              <div id="newAddressForm" class="<%= savedAddresses.length === 0 ? 'show' : 'hide' %>" style="margin-top:16px;">
                                <% if (savedAddresses.length> 0) { %>
                                  <hr style="margin-bottom:16px;">
                                  <% } %>
                                    <h3 class="new-address-title">New Delivery Address</h3>

                                    <div class="form-row-2">
                                      <div class="form-group">
                                        <label>Full Name *</label>
                                        <input type="text" name="new_address[full_name]"
                                          class="form-control new-address-field" placeholder="Recipient's name">
                                      </div>
                                      <div class="form-group">
                                        <label>Mobile *</label>
                                        <input type="tel" name="new_address[phone]"
                                          class="form-control new-address-field" placeholder="+91 9999999999">
                                      </div>
                                    </div>

                                    <div class="form-group">
                                      <label>Address *</label>
                                      <textarea name="new_address[address_line]" class="form-control new-address-field"
                                        rows="2" placeholder="House/Flat no., Street, Area"></textarea>
                                    </div>

                                    <div class="form-row-3">
                                      <div class="form-group">
                                        <label>City *</label>
                                        <input type="text" name="new_address[city]"
                                          class="form-control new-address-field" placeholder="Vijayawada">
                                      </div>
                                      <div class="form-group">
                                        <label>State *</label>
                                        <input type="text" name="new_address[state]"
                                          class="form-control new-address-field" placeholder="Andhra Pradesh">
                                      </div>
                                      <div class="form-group">
                                        <label>Pin-code *</label>
                                        <input type="text" name="new_address[pincode]"
                                          class="form-control new-address-field" placeholder="520001">
                                      </div>
                                    </div>
                              </div>
                    </div>
                  </div>

                  <div class="card mb-24">
                    <div class="card-header">
                      <h2>Payment Method</h2>
                    </div>
                    <div class="card-body">
                      <div class="payment-options">
                        <label class="payment-option">
                          <input type="radio" name="payment_method" value="cod" checked>
                          <div class="payment-option-body">
                            <span class="payment-icon">COD</span>
                            <div>
                              <strong>Cash on Delivery</strong>
                              <p class="text-sm text-muted">Pay when your order arrives</p>
                            </div>
                          </div>
                        </label>
                        <label class="payment-option">
                          <input type="radio" name="payment_method" value="whatsapp">
                          <div class="payment-option-body">
                            <span class="payment-icon wa-icon">&#128172;</span>
                            <div>
                              <strong>Pay through WhatsApp</strong>
                              <p class="text-sm text-muted">Send order details & pay via WhatsApp</p>
                            </div>
                          </div>
                        </label>
                      </div>

                      <div class="whatsapp-pay-row" id="whatsappPayRow" style="display:none;">
                        <div class="whatsapp-pay-info">
                          <span class="wp-icon">&#128172;</span>
                          <div class="wp-note">Send your order details to our WhatsApp team. We will confirm and process your order shortly.</div>
                        </div>
                        <button type="button" class="btn btn-whatsapp" id="whatsappPayBtn" style="margin-top:10px;">&#128172;&nbsp; Pay Now on WhatsApp</button>
                      </div>

                      <div class="form-group mt-16">
                        <label>Order Notes (optional)</label>
                        <textarea name="notes" id="orderNotes" class="form-control" rows="2"
                          placeholder="Special instructions, preferred delivery time..."></textarea>
                      </div>
                    </div>
                  </div>
                </div>

                <div>
                  <div class="card sticky-card checkout-summary-card">
                    <div class="card-header">
                      <h2>Order Summary</h2>
                    </div>
                    <div class="card-body">
                      <div class="checkout-items">
                        <% cartItems.forEach(item=> { %>
                          <div class="checkout-item">
                            <img src="<%= item.image || '/images/placeholder.png' %>" alt="<%= item.name %>"
                              class="checkout-item-img" onerror="this.src='/images/placeholder.png'">
                            <div class="checkout-item-info">
                              <p class="checkout-item-name">
                                <a href="/products/<%= item.product_id %>" style="font-weight:500;color:var(--black)">
                                  <%= item.name %>
                                    <% if (item.selected_weight) { %>
                                      <span style="font-size:0.85em;color:var(--gray-500);font-weight:400;">(<%=
                                          item.selected_weight %>)</span>
                                      <% } %>
                                </a>
                              </p>
                              <p class="text-sm text-muted">Qty: <%= item.quantity %>
                              </p>
                              <% if (typeof item.stock !=='undefined' && item.quantity> item.stock) { %>
                                <p class="text-sm" style="color:var(--danger);">Insufficient stock</p>
                                <% } %>
                            </div>
                            <div class="checkout-item-price">&#8377;<%= Number(item.subtotal).toLocaleString('en-IN') %>
                            </div>
                          </div>
                          <% }) %>
                      </div>

                      <div class="coupon-inline-box">
                        <% if (appliedCoupon) { %>
                          <div class="coupon-inline-applied">
                            <div>
                              <strong>Coupon Applied:</strong>
                              <%= appliedCoupon.code %>
                            </div>
                            <a href="/cart" class="btn btn-outline btn-sm">Change</a>
                          </div>
                          <% } else { %>
                            <div class="coupon-inline-applied">
                              <div>Apply coupon from cart page.</div>
                              <a href="/cart" class="btn btn-outline btn-sm">Go to Cart</a>
                            </div>
                            <% } %>
                      </div>

                      <hr>

                      <div class="price-summary">
                        <div class="price-row">
                          <span>Subtotal (<%= typeof totalItems !=='undefined' ? totalItems : cartItems.reduce((s, i)=>
                              s + i.quantity, 0) %> items)</span>
                          <span>&#8377;<%= Number(typeof originalSubtotal !=='undefined' ? originalSubtotal : (typeof
                              subtotal !=='undefined' ? subtotal : total)).toLocaleString('en-IN') %></span>
                        </div>
                        <% if (typeof offerDiscount !=='undefined' && Number(offerDiscount)> 0) { %>
                          <div class="price-row" style="color:var(--success, green);">
                            <span>Offer Discount</span>
                            <span>-&#8377;<%= Number(offerDiscount).toLocaleString('en-IN') %></span>
                          </div>
                          <% } %>
                            <% if (appliedCoupon) { %>
                              <div class="price-row" style="color:var(--success, green);">
                                <span>Coupon (<%= appliedCoupon.code %>)</span>
                                <span>-&#8377;<%= Number(couponDiscount || 0).toLocaleString('en-IN') %></span>
                              </div>
                              <% } else if (couponError) { %>
                                <div class="price-row" style="color:var(--danger, #d9534f);font-size:12px;">
                                  <span>Coupon</span>
                                  <span>
                                    <%= couponError %>
                                  </span>
                                </div>
                                <% } %>
                                  <div class="price-row">
                                    <span>Delivery</span>
                                    <span style="color:var(--success, green);">Free</span>
                                  </div>
                                  <hr>
                                  <div class="price-row total-row">
                                    <strong>Total</strong>
                                    <strong>&#8377;<%= Number(total).toLocaleString('en-IN') %></strong>
                                  </div>
                      </div>

                      <div class="checkout-actions">
                        <button type="button" class="btn btn-outline btn-block btn-print-modern"
                          onclick="printBill()">PDF Bill Preview</button>
                        <button type="submit" class="btn btn-primary btn-block btn-lg" id="placeOrderBtn">Place
                          Order</button>
                      </div>

                      <p class="checkout-legal-note">
                        By placing your order, you agree to our Terms of Service.
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </form>
  </div>



  <section id="printBill" class="print-bill">
    <div class="print-bill-header">
      <h1>
        <%= (settings && settings.store_name) ? settings.store_name : 'Shanmukha Stores' %>
      </h1>
      <p>Bill Preview</p>
    </div>

    <div class="print-bill-meta">
      <div><strong>Bill No:</strong> <span id="printBillNo">-</span></div>
      <div><strong>Date:</strong> <span id="printDate">-</span></div>
      <div><strong>Payment:</strong> <span id="printPayment">Cash on Delivery</span></div>
    </div>

    <div class="print-address">
      <h3>Delivery Address</h3>
      <p id="printAddressText">-</p>
    </div>

    <table class="print-bill-table">
      <thead>
        <tr>
          <th>Item</th>
          <th>Qty</th>
          <th style="text-align:right;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% cartItems.forEach(item=> { %>
          <tr>
            <td>
              <%= item.name %>
                <% if (item.selected_weight) { %>
                  <span style="color:#666;">(<%= item.selected_weight %>)</span>
                  <% } %>
            </td>
            <td>
              <%= item.quantity %>
            </td>
            <td style="text-align:right;">&#8377;<%= Number(item.subtotal).toLocaleString('en-IN') %>
            </td>
          </tr>
          <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2"><strong>Total</strong></td>
          <td style="text-align:right;"><strong>&#8377;<%= Number(total).toLocaleString('en-IN') %></strong></td>
        </tr>
      </tfoot>
    </table>

    <p class="print-note">This is a system-generated bill preview from checkout.</p>
  </section>

  <!-- EJS variables for JavaScript use -->
  <div id="checkout-data" style="display: none;"
       data-bill-items='<%- JSON.stringify(cartItems || []) %>'
       data-store-name='<%- ((settings && settings.store_name) ? settings.store_name.replace(/'/g, "\\'").replace(/</g, "\\u003c") : 'Shanmukha Stores') %>'
       data-subtotal-value='<%- typeof originalSubtotal !== 'undefined' ? originalSubtotal : (typeof subtotal !== 'undefined' ? subtotal : total) %>'
       data-offer-discount-value='<%- typeof offerDiscount !== 'undefined' ? offerDiscount : 0 %>'
       data-coupon-discount-value='<%- typeof couponDiscount !== 'undefined' ? couponDiscount : 0 %>'
       data-total-value='<%- total %>'
       data-coupon-code-value='<%- ((appliedCoupon && appliedCoupon.code) ? appliedCoupon.code.replace(/'/g, "\\'").replace(/</g, "\\u003c") : '') %>'>
  </div>

  <!-- Add Address Modal -->
  <div id="addAddressModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Add Address</h3>
        <button type="button" class="close-btn" onclick="closeAddAddressModal()">x</button>
      </div>
      <form id="addAddressAjaxForm" method="POST" action="/addresses/add?from=checkout">
        <div class="form-row-2">
          <div class="form-group">
            <label>Full Name *</label>
            <input type="text" name="full_name" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Mobile *</label>
            <input type="tel" name="phone" class="form-control" required>
          </div>
        </div>
        <div class="form-group">
          <label>Address *</label>
          <textarea name="address_line" class="form-control" rows="3" required></textarea>
        </div>
        <div class="form-row-3">
          <div class="form-group">
            <label>City *</label>
            <input type="text" name="city" class="form-control" required>
          </div>
          <div class="form-group">
            <label>State *</label>
            <input type="text" name="state" class="form-control" required>
          </div>
          <div class="form-group">
            <label>Pin-code *</label>
            <input type="text" name="pincode" class="form-control" required>
          </div>
        </div>
        <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-top: 10px;">
          <input type="checkbox" name="is_default" id="is_default_checkbox" value="true">
          <label for="is_default_checkbox" style="margin: 0;">Set as default address</label>
        </div>
        
        <div id="addAddressErrorMsg" style="display:none; color: #d9534f; font-size: 14px; margin-top: 12px; font-weight: 500;"></div>
        
        <div class="modal-actions" style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
          <button type="button" class="btn btn-outline" onclick="closeAddAddressModal()">Cancel</button>
          <button type="submit" class="btn" style="background-color: var(--black, #111); color: #fff;">Save Address</button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000;
    }
    .modal-content {
      background: #fff;
      border-radius: 12px;
      width: 90%;
      max-width: 600px;
      max-height: 90vh;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .modal-header {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;
    }
    .modal-header h3 { margin: 0; font-size: 20px; font-weight: bold; }
    .close-btn {
      background: none; border: 1px solid #ddd; border-radius: 50%;
      width: 32px; height: 32px; cursor: pointer; font-size: 16px;
      display: flex; align-items: center; justify-content: center;
    }
    .close-btn:hover { background: #f0f0f0; }
  </style>

  <script>
    function openAddAddressModal() {
      document.getElementById('addAddressModal').style.display = 'flex';
    }
    function closeAddAddressModal() {
      document.getElementById('addAddressModal').style.display = 'none';
      document.getElementById('addAddressErrorMsg').style.display = 'none';
    }

    document.getElementById('addAddressAjaxForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const form = e.target;
      const errorMsgEl = document.getElementById('addAddressErrorMsg');
      errorMsgEl.style.display = 'none';
      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const formData = new URLSearchParams(new FormData(form));
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        });
        
        // Express backend will send a 302 redirect on success or error.
        // fetch follows redirects by default. We can check the final URL.
        const finalUrl = response.url;
        if (finalUrl.includes('error=')) {
          const params = new URLSearchParams(finalUrl.split('?')[1]);
          errorMsgEl.textContent = params.get('error') || 'Failed to save address.';
          errorMsgEl.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Save Address';
        } else {
          // Success! Reload the page to reflect new address.
          window.location.reload();
        }
      } catch (err) {
        errorMsgEl.textContent = 'Network error occurred. Please try again.';
        errorMsgEl.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Address';
      }
    });

    function setAddressRequired(isRequired) {
      document.querySelectorAll(".new-address-field").forEach((el) => {
        el.required = !!isRequired;
      });
    }

    function toggleNewAddress(show) {
      const form = document.getElementById("newAddressForm");
      if (form) {
        form.style.display = show ? "block" : "none";
      }
      setAddressRequired(show);
    }

    function selectedAddressText() {
      const selected = document.querySelector("input[name='address_id']:checked");
      if (!selected) return "Address not selected";

      if (selected.value === "new") {
        const fullName = document.querySelector("[name='new_address[full_name]']")?.value || "";
        const phone = document.querySelector("[name='new_address[phone]']")?.value || "";
        const line = document.querySelector("[name='new_address[address_line]']")?.value || "";
        const city = document.querySelector("[name='new_address[city]']")?.value || "";
        const state = document.querySelector("[name='new_address[state]']")?.value || "";
        const pincode = document.querySelector("[name='new_address[pincode]']")?.value || "";

        return [fullName, phone, line, city, state, pincode].filter(Boolean).join(", ");
      }

      const card = selected.closest("label")?.querySelector(".address-option-body");
      return card ? card.innerText.replace(/\s+/g, " ").trim() : "Address not selected";
    }

    function buildWhatsAppMessage(orderId) {
      const checkoutData = document.getElementById('checkout-data');
      const billItems = JSON.parse(checkoutData.dataset.billItems || '[]');
      const storeName = checkoutData.dataset.storeName || 'Shanmukha Stores';
      const subtotalValue = parseFloat(checkoutData.dataset.subtotalValue) || 0;
      const offerDiscountValue = parseFloat(checkoutData.dataset.offerDiscountValue) || 0;
      const couponDiscountValue = parseFloat(checkoutData.dataset.couponDiscountValue) || 0;
      const totalValue = parseFloat(checkoutData.dataset.totalValue) || 0;
      const couponCodeValue = checkoutData.dataset.couponCodeValue || '';
      const addressText = selectedAddressText();
      const notes = document.getElementById('orderNotes')?.value?.trim() || '';

      const inr = (n) => `Rs. ${Number(n || 0).toLocaleString('en-IN')}`;

      const itemLines = billItems.map((item, idx) => {
        const weight = item.selected_weight ? ` (${item.selected_weight})` : '';
        return `▫️ *${item.name}${weight}*\n    Qty: ${item.quantity}  |  Price: ${inr(item.subtotal)}`;
      }).join('\n\n');

      let msg = `🛒 *NEW ORDER - ${storeName.toUpperCase()}*\n`;
      msg += `━━━━━━━━━━━━━━━━━━━━\n\n`;
      if (orderId) msg += `🔖 *Order ID:* #${orderId}\n\n`;

      msg += `📦 *ORDER ITEMS:*\n${itemLines}\n\n`;

      msg += `💵 *PAYMENT SUMMARY:*\n`;
      msg += `  ▫️ Subtotal: ${inr(subtotalValue)}\n`;
      if (offerDiscountValue > 0) msg += `  ▫️ Offer Discount: -${inr(offerDiscountValue)}\n`;
      if (couponDiscountValue > 0) msg += `  ▫️ Coupon${couponCodeValue ? ' (' + couponCodeValue + ')' : ''}: -${inr(couponDiscountValue)}\n`;
      msg += `  ▫️ Delivery Fee: *FREE*\n`;
      msg += `  ✨ *TOTAL PAYABLE: ${inr(totalValue)}*\n\n`;

      msg += `📍 *DELIVERY ADDRESS:*\n${addressText}\n\n`;
      msg += `💳 *PAYMENT METHOD:* WhatsApp Pay\n`;
      if (notes) msg += `📝 *CUSTOMER NOTE:* ${notes}\n\n`;

      msg += `━━━━━━━━━━━━━━━━━━━━\n`;
      msg += `Hello! I just placed an order. Please confirm the details. 🙏✨`;
      return msg;
    }

    async function openWhatsApp() {
      const btn = document.getElementById('whatsappPayBtn');
      const originalHTML = btn ? btn.innerHTML : '';
      try {
        // Validate address first
        const selected = document.querySelector("input[name='address_id']:checked");
        if (!selected) { alert("Please select a delivery address."); return; }
        if (selected.value === "new") {
          const fn = document.querySelector("[name='new_address[full_name]']")?.value?.trim();
          const ph = document.querySelector("[name='new_address[phone]']")?.value?.trim();
          const ln = document.querySelector("[name='new_address[address_line]']")?.value?.trim();
          const ct = document.querySelector("[name='new_address[city]']")?.value?.trim();
          const st = document.querySelector("[name='new_address[state]']")?.value?.trim();
          const pi = document.querySelector("[name='new_address[pincode]']")?.value?.trim();
          if (!fn || !ph || !ln || !ct || !st || !pi) { alert("Please fill all required address fields."); return; }
          if (!/^[0-9+\-() ]{8,20}$/.test(ph)) { alert("Please enter a valid mobile number."); return; }
        }

        // Show loading
        if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Placing order...'; }

        // POST to JSON endpoint
        const form = document.getElementById('checkoutForm');
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);

        const response = await fetch('/orders/place-whatsapp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString()
        });

        const data = await response.json();

        if (!data.ok) {
          if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
          alert(data.error || 'Something went wrong. Please try again.');
          return;
        }

        const orderId = data.orderId;

        // Open WhatsApp with order details (including order ID)
        const phone = '918886383838';
        const msg = buildWhatsAppMessage(orderId);
        const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
        window.open(waUrl, '_blank');

        // Redirect to confirmation page
        window.location.href = `/orders/success/${orderId}`;

      } catch (err) {
        console.error('WhatsApp order error:', err);
        if (btn) { btn.disabled = false; btn.innerHTML = originalHTML; }
        alert('Something went wrong. Please try again.');
      }
    }

    function printBill() {
      const now = new Date();
      const billNo = `PRE-${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, "0")}${String(now.getDate()).padStart(2, "0")}-${now.getHours()}${now.getMinutes()}${now.getSeconds()}`;
      const selectedPayment = document.querySelector("input[name='payment_method']:checked")?.value || "cod";
      const paymentLabel = selectedPayment === "cod" ? "Cash on Delivery" : selectedPayment === "whatsapp" ? "WhatsApp Pay" : selectedPayment.toUpperCase();
      const addressText = selectedAddressText();

      const checkoutData = document.getElementById('checkout-data');
      const billItems = JSON.parse(checkoutData.dataset.billItems);
      const storeName = checkoutData.dataset.storeName;
      const subtotalValue = parseFloat(checkoutData.dataset.subtotalValue);
      const offerDiscountValue = parseFloat(checkoutData.dataset.offerDiscountValue);
      const couponDiscountValue = parseFloat(checkoutData.dataset.couponDiscountValue);
      const totalValue = parseFloat(checkoutData.dataset.totalValue);
      const couponCodeValue = checkoutData.dataset.couponCodeValue;

      const inr = (n) => `Rs. ${Number(n || 0).toLocaleString("en-IN")}`;
      const itemRows = billItems.map((item, idx) => {
        const weight = item.selected_weight ? ` (${item.selected_weight})` : "";
        return `<tr>
          <td>${idx + 1}</td>
          <td>${item.name}${weight}</td>
          <td>${item.quantity}</td>
          <td class="num">${inr(item.subtotal)}</td>
        </tr>`;
      }).join("");

      const discountRows = `
        ${offerDiscountValue > 0 ? `<div class="sum-row"><span>Offer Discount</span><strong>- ${inr(offerDiscountValue)}</strong></div>` : ""}
        ${couponDiscountValue > 0 ? `<div class="sum-row"><span>Coupon${couponCodeValue ? ` (${couponCodeValue})` : ""}</span><strong>- ${inr(couponDiscountValue)}</strong></div>` : ""}
      `;

      const previewHtml = `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>${storeName} Bill Preview</title>
  <style>
    @page { size: A4; margin: 10mm; }
    body { margin: 0; background: #eef1ef; font-family: Arial, sans-serif; color: #111; }
    .toolbar { max-width: 840px; margin: 14px auto 8px; display: flex; justify-content: flex-end; }
    .toolbar button { border: 1px solid #0a0a0a; background: #0a0a0a; color: #fff; border-radius: 999px; padding: 9px 14px; cursor: pointer; font-weight: 700; font-size: 12px; }
    .sheet { width: 794px; min-height: 1123px; margin: 0 auto 18px; background: #fff; box-shadow: 0 14px 30px rgba(0,0,0,.12); box-sizing: border-box; padding: 24px; }
    .h1 { margin: 0; font-size: 24px; }
    .sub { margin: 4px 0 0; color: #666; font-size: 12px; }
    .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 16px 0; font-size: 12px; }
    .card { border: 1px solid #e6e6e6; border-radius: 10px; padding: 10px 12px; margin-bottom: 12px; font-size: 12px; line-height: 1.4; }
    table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 12px; }
    th, td { border-bottom: 1px solid #ececec; padding: 7px 6px; text-align: left; vertical-align: top; }
    th { font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: #555; background: #fafafa; }
    .num { text-align: right; white-space: nowrap; }
    .summary { margin-top: 12px; margin-left: auto; width: 300px; border: 1px solid #ececec; border-radius: 10px; padding: 8px 10px; font-size: 12px; }
    .sum-row { display: flex; justify-content: space-between; gap: 8px; padding: 6px 0; border-bottom: 1px dashed #ececec; }
    .sum-row:last-child { border-bottom: none; }
    .sum-row.total { font-size: 15px; font-weight: 700; color: #111; }
    .foot { margin-top: 10px; font-size: 11px; color: #777; text-align: center; }
    @media print {
      body { background: #fff; }
      .toolbar { display: none; }
      .sheet { margin: 0; width: auto; min-height: auto; box-shadow: none; padding: 0; }
    }
  </style>
</head>
<body>
  <div class="toolbar"><button onclick="window.print()">Print / Save PDF</button></div>
  <div class="sheet">
    <h1 class="h1">${storeName}</h1>
    <p class="sub">Compact Bill Preview</p>
    <div class="meta">
      <div><strong>Bill No:</strong> ${billNo}</div>
      <div><strong>Date:</strong> ${now.toLocaleString("en-IN")}</div>
      <div><strong>Payment:</strong> ${paymentLabel}</div>
      <div><strong>Items:</strong> ${billItems.length}</div>
    </div>
    <div class="card"><strong>Delivery Address</strong><br>${addressText || "-"}</div>
    <table>
      <thead>
        <tr><th style="width:40px">No</th><th>Item</th><th style="width:60px">Qty</th><th class="num" style="width:120px">Amount</th></tr>
      </thead>
      <tbody>${itemRows}</tbody>
    </table>
    <div class="summary">
      <div class="sum-row"><span>Subtotal</span><strong>${inr(subtotalValue)}</strong></div>
      ${discountRows}
      <div class="sum-row"><span>Delivery</span><strong>Free</strong></div>
      <div class="sum-row total"><span>Total</span><strong>${inr(totalValue)}</strong></div>
    </div>
    <p class="foot">System-generated bill preview from checkout.</p>
  </div>
</body>
</html>`;

      const previewWindow = window.open("", "_blank", "width=980,height=900");
      if (!previewWindow) {
        alert("Please allow popups to view the PDF bill preview.");
        return;
      }
      previewWindow.document.open();
      previewWindow.document.write(previewHtml);
      previewWindow.document.close();
    }

    document.getElementById("checkoutForm").addEventListener("submit", function (e) {
      const selectedPayment = document.querySelector("input[name='payment_method']:checked")?.value || "cod";

      const selected = document.querySelector("input[name='address_id']:checked");
      if (!selected) {
        e.preventDefault();
        alert("Please select a delivery address.");
        return;
      }

      if (selected.value === "new") {
        const fullName = document.querySelector("[name='new_address[full_name]']")?.value?.trim();
        const phone = document.querySelector("[name='new_address[phone]']")?.value?.trim();
        const line = document.querySelector("[name='new_address[address_line]']")?.value?.trim();
        const city = document.querySelector("[name='new_address[city]']")?.value?.trim();
        const state = document.querySelector("[name='new_address[state]']")?.value?.trim();
        const pincode = document.querySelector("[name='new_address[pincode]']")?.value?.trim();
        if (!fullName || !phone || !line || !city || !state || !pincode) {
          e.preventDefault();
          alert("Please fill all required address fields including mobile number.");
          return;
        }
        if (!/^[0-9+\-() ]{8,20}$/.test(phone)) {
          e.preventDefault();
          alert("Please enter a valid mobile number.");
          return;
        }
      }

      if (selectedPayment === "whatsapp") {
        e.preventDefault();
        openWhatsApp();
        return;
      }

      const btn = document.getElementById("placeOrderBtn");
      if (btn) btn.dataset.submitting = "true";
      btn.disabled = true;
      btn.textContent = "Placing Order...";
    });

    document.addEventListener("DOMContentLoaded", function () {
      const selected = document.querySelector("input[name='address_id']:checked");
      toggleNewAddress(selected && selected.value === "new");

      const paymentRadios = document.querySelectorAll("input[name='payment_method']");
      const whatsappPayRow = document.getElementById("whatsappPayRow");
      const whatsappPayBtn = document.getElementById("whatsappPayBtn");
      const placeOrderBtn = document.getElementById("placeOrderBtn");

      const updatePaymentUi = () => {
        const selectedPayment = document.querySelector("input[name='payment_method']:checked")?.value || "cod";
        if (selectedPayment === "whatsapp") {
          whatsappPayRow.style.display = "flex";
          placeOrderBtn.style.display = "none";
        } else {
          whatsappPayRow.style.display = "none";
          placeOrderBtn.style.display = "";
        }
      };

      paymentRadios.forEach((radio) => {
        radio.addEventListener("change", updatePaymentUi);
      });

      whatsappPayBtn?.addEventListener("click", () => {
        openWhatsApp();
      });

      updatePaymentUi();
    });
  </script>

