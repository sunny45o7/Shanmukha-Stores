<%- include('_header') %>
    <% const editDefaultWeightOptions = defaultWeightOptions || ['10gm','20gm','50gm','100gm','150gm','200gm','250gm','500gm','750gm','1kg']; %>
    <% const selectedWeightOptions = productWeightOptions || []; %>
    <% const editWeightOptions = Array.from(new Set([...editDefaultWeightOptions, ...selectedWeightOptions])); %>

    <% if(success) { %>
        <div class="alert alert-ok">✅ <%= success %>
        </div>
        <% } %>
            <% if(error) { %>
                <div class="alert alert-err">❌ <%= error %>
                </div>
                <% } %>

                    <div class="page-hd">
                        <div>
                            <h2>Edit Product</h2>
                            <p>Editing: <strong>
                                    <%= product.name %>
                                </strong></p>
                        </div>
                        <a href="/admin/products" class="btn btn-ghost">← Back to Products</a>
                    </div>

                    <div class="card">
                        <div class="card-body">
	                            <form action="/admin/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
                                <div class="form-grid-2">
                                    <div class="form-group" style="grid-column:1/-1">
                                        <label>Product Name *</label>
                                        <input type="text" name="name" required value="<%= product.name %>">
                                    </div>
                                    <div class="form-group">
                                        <label>Price (₹) *</label>
                                        <input type="number" name="price" required min="0" step="0.01"
                                            value="<%= product.price %>">
                                    </div>
	                                    <div class="form-group">
	                                        <label>Price Type</label>
	                                        <select name="price_type" id="editPriceType" onchange="toggleWeightSection('edit')">
	                                            <option value="unit" <%=product.price_type==='unit' ? 'selected' : '' %>>Per
	                                                Unit</option>
	                                            <option value="kg" <%=product.price_type==='kg' ? 'selected' : '' %>>Per KG
	                                            </option>
	                                        </select>
                                    </div>
	                                    <div class="form-group">
	                                        <label>Stock *</label>
	                                        <input type="number" name="stock" required min="0" value="<%= product.stock %>">
	                                    </div>
	                                    <div class="form-group" id="editWeightSection" style="grid-column:1/-1; border:1px solid var(--border); border-radius:12px; padding:14px;">
	                                        <label style="display:block; margin-bottom:8px;">Available Weight Options</label>
	                                        <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
	                                            <% editWeightOptions.forEach(weight => { %>
	                                                <label style="display:inline-flex; align-items:center; gap:6px; border:1px solid var(--border); border-radius:999px; padding:6px 12px; background:#fff;">
	                                                    <input type="checkbox" name="weight_options" value="<%= weight %>" <%= selectedWeightOptions.includes(weight) ? 'checked' : '' %>>
	                                                    <span><%= weight %></span>
	                                                </label>
	                                            <% }) %>
	                                        </div>
	                                        <div style="display:grid; grid-template-columns:1fr auto; gap:10px; margin-bottom:8px;">
	                                            <input type="text" id="editCustomWeightInput" placeholder="Add custom weight (e.g. 20gm or 2kg)">
	                                            <button type="button" class="btn btn-ghost btn-sm" onclick="appendCustomWeight('edit')">Add Custom Weight</button>
	                                        </div>
	                                        <textarea name="custom_weight_options" id="editCustomWeights" rows="2" placeholder="Custom weights (comma separated), e.g. 20gm, 50gm"></textarea>
	                                        <p style="font-size:12px; color:var(--gray-500); margin-top:8px;">Selected options will appear on the product detail page.</p>
	                                    </div>
	                                    <% if (user && user.role === 'admin') { %>
	                                        <div class="form-group">
	                                            <label>Offer %</label>
                                            <input type="number" name="offer_percent" min="1" max="100" step="0.01"
                                                value="<%= Number(product.offer_percent) || 1 %>" oninput="if(this.value > 100) this.value = 100;" onblur="if(this.value !== '' && this.value < 1) this.value = 1;">
                                        </div>
                                        <div class="form-group" style="display:flex;align-items:center;gap:10px;margin-top:30px;">
                                            <label class="toggle-switch">
                                                <input type="checkbox" id="offer_active" name="offer_active" <%= product.offer_active ? 'checked' : '' %>>
                                                <span class="toggle-slider"></span>
                                            </label>
                                            <label for="offer_active" class="form-label" style="margin:0;">Enable product offer</label>
                                        </div>
                                    <% } %>
                                    <div class="form-group">
                                        <label>Category</label>
                                        <select name="category_id">
                                            <option value="">— Select Category —</option>
                                            <% categories.forEach(c=> { %>
                                                <option value="<%= c.id %>" <%=c.id==product.category_id ? 'selected'
                                                    : '' %>><%= c.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
	                                    <div class="form-group" style="grid-column:1/-1">
	                                        <label>Product Image URL</label>
	                                        <input type="url" name="image" value="<%= product.image || '' %>">
	                                    </div>
	                                    <div class="form-group" style="grid-column:1/-1">
	                                        <label>Upload Additional Product Images/Videos</label>
	                                        <input type="file" name="product_images" accept="image/*,video/*" multiple webkitdirectory directory>
	                                        <p style="font-size:12px; color:var(--gray-500); margin-top:8px;">
	                                            Choose multiple files or a folder to append to the product gallery.
	                                        </p>
	                                    </div>
	                                    <div class="form-group" style="grid-column:1/-1">
	                                        <label>Product Description</label>
                                        <textarea name="description" rows="5"
                                            placeholder="Write about the product..."><%= product.description || '' %></textarea>
                                    </div>
                                </div>

	                                <% if(product.image) { %>
	                                    <div style="margin-bottom:20px;">
	                                        <p style="font-size:12px;color:var(--gray-500);margin-bottom:8px;">Current
	                                            Image:</p>
                                            <% if (product.image.match(/\.(mp4|webm|ogg)$/i)) { %>
                                                <video src="<%= product.image %>" autoplay muted loop playsinline style="width:120px;height:120px;object-fit:cover;border-radius:10px;border:1px solid var(--border);"></video>
                                            <% } else { %>
                                                <img src="<%= product.image %>"
                                                    style="width:120px;height:120px;object-fit:cover;border-radius:10px;border:1px solid var(--border);"
                                                    onerror="this.style.display='none'">
                                            <% } %>
	                                    </div>
	                                    <% } %>

	                                <% if (productImages && productImages.length > 0) { %>
	                                    <div style="margin-bottom:20px;">
	                                        <p style="font-size:12px;color:var(--gray-500);margin-bottom:8px;">Product Gallery:</p>
	                                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;">
	                                            <% productImages.forEach((img) => { %>
	                                                <div style="border:1px solid var(--border);border-radius:10px;padding:8px;background:#fff;">
                                                        <% if (img.image_url && img.image_url.match(/\.(mp4|webm|ogg)$/i)) { %>
                                                            <video src="<%= img.image_url %>" autoplay muted loop playsinline style="width:100%;height:100px;object-fit:cover;border-radius:8px;"></video>
                                                        <% } else { %>
	                                                        <img src="<%= img.image_url %>" alt="Product image" style="width:100%;height:100px;object-fit:cover;border-radius:8px;">
                                                        <% } %>
	                                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;gap:8px;">
	                                                        <% if (img.is_primary) { %>
	                                                            <span style="font-size:11px;padding:3px 8px;border-radius:999px;background:#e8f5e9;color:#2e7d32;">Primary</span>
	                                                        <% } else { %>
	                                                            <span style="font-size:11px;color:var(--gray-500);">Gallery</span>
	                                                        <% } %>
	                                                        <button type="button" class="btn btn-red btn-sm" style="padding:4px 8px;font-size:11px;" onclick="return confirmDeleteImage('<%= img.id %>')">Delete</button>
	                                                    </div>
	                                                </div>
	                                            <% }) %>
	                                        </div>
	                                    </div>
	                                <% } %>

	                                        <div style="display:flex;gap:10px;">
                                            <button type="submit" class="btn btn-black">Save Changes</button>
                                            <a href="/admin/products" class="btn btn-ghost">Cancel</a>
                                        </div>
	                            </form>
	                            <% if (productImages && productImages.length > 0) { %>
	                                <% productImages.forEach((img) => { %>
	                                    <form id="delete-image-form-<%= img.id %>" method="POST" action="/admin/products/images/delete/<%= img.id %>" style="display:none;"></form>
	                                <% }) %>
	                            <% } %>
	                        </div>
		                    </div>

	                    <script>
	                        function toggleWeightSection(prefix) {
	                            const priceType = document.getElementById(prefix + 'PriceType');
	                            const section = document.getElementById(prefix + 'WeightSection');
	                            if (!priceType || !section) return;
	                            section.style.display = priceType.value === 'kg' ? 'block' : 'none';
	                        }
		                        function appendCustomWeight(prefix) {
		                            const input = document.getElementById(prefix + 'CustomWeightInput');
	                            const target = document.getElementById(prefix + 'CustomWeights');
	                            if (!input || !target) return;
	                            const value = String(input.value || '').trim();
	                            if (!value) return;
	                            target.value = target.value ? `${target.value}, ${value}` : value;
		                            input.value = '';
		                            input.focus();
		                        }
		                        function confirmDeleteImage(imageId) {
		                            if (!confirm('Delete this image?')) return false;
		                            const form = document.getElementById('delete-image-form-' + imageId);
		                            if (form) form.submit();
		                            return false;
		                        }
		                        toggleWeightSection('edit');
		                    </script>

	                    <%- include('_footer') %>
