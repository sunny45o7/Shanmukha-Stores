<%- include('_header') %>

    <% if(success) { %>
        <div class="alert alert-ok">✅ <%= success %>
        </div>
        <% } %>
            <% if(error) { %>
                <div class="alert alert-err">❌ <%= error %>
                </div>
                <% } %>

                    <div class="page-hd">
                        <div>
                            <h2>Popup Ads</h2>
                            <p>Manage promotional popup ads with mandatory wait times</p>
                        </div>
                        <button class="btn btn-black" onclick="openModal('addPopupAd')">+ Add Popup Ad</button>
                    </div>

                    <div class="card">
                        <div class="tbl-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Ad Image</th>
                                        <th>Title</th>
                                        <th>Target URL</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% popupAds.forEach(ad=> { %>
                                        <tr>
                                            <td>
                                                <% if (ad.image_url && ad.image_url.match(/\.(mp4|webm|ogg)$/i)) { %>
                                                    <video src="<%= ad.image_url %>" autoplay muted loop playsinline style="width:100px;height:54px;object-fit:cover;border-radius:7px;background:var(--gray-100);"></video>
                                                <% } else { %>
                                                    <img src="<%= ad.image_url %>"
                                                        style="width:100px;height:54px;object-fit:cover;border-radius:7px;background:var(--gray-100);"
                                                        onerror="this.style.background='var(--gray-100)';this.style.minHeight='54px'">
                                                <% } %>
                                            </td>
                                            <td style="font-weight:700;color:var(--black);">
                                                <%= ad.title %>
                                            </td>
                                            <td
                                                style="color:var(--gray-500);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                                <%= ad.target_url || '—' %>
                                            </td>
                                            <td>
                                                <% if(ad.is_active) { %>
                                                    <span class="badge bg-green">Active</span>
                                                    <% } else { %>
                                                        <span class="badge bg-gray">Inactive</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                                    <button class="btn btn-blue btn-sm" data-id="<%= ad.id %>"
                                                        data-title="<%= ad.title %>" data-image="<%= ad.image_url %>"
                                                        data-target="<%= ad.target_url || '' %>"
                                                        onclick="openEditPopupAd(this.dataset.id, this.dataset.title, this.dataset.image, this.dataset.target)">Edit</button>
                                                    <form action="/admin/popup-ads/toggle/<%= ad.id %>" method="POST">
                                                        <button type="submit" class="btn btn-ghost btn-sm">
                                                            <%= ad.is_active ? 'Deactivate' : 'Activate' %>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/popup-ads/delete/<%= ad.id %>" method="POST"
                                                        onsubmit="return confirm('Delete this popup ad?')">
                                                        <button type="submit" class="btn btn-red btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% if(!popupAds.length) { %>
                                                <tr>
                                                    <td colspan="5">
                                                        <div class="empty">
                                                            <div class="big">🪟</div>
                                                            <h3>No popup ads yet</h3>
                                                            <p>Create popup ads to capture user attention</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ADD POPUP AD MODAL -->
                    <div class="modal-bg" id="addPopupAd">
                        <div class="modal" style="max-width:560px;">
                            <div class="modal-hd">
                                <h3>Add Popup Ad</h3>
                                <button class="modal-close" onclick="closeModal('addPopupAd')">✕</button>
                            </div>
                            <form action="/admin/popup-ads/add" method="POST" enctype="multipart/form-data">
                                <div class="form-group">
                                    <label>Ad Title *</label>
                                    <input type="text" name="title" required placeholder="e.g. Summer Sale 50% Off">
                                </div>
                                <div class="form-group">
                                    <label>Image/Video Upload *</label>
                                    <input type="file" name="image_file" accept="image/*,video/*">
                                    <small style="display:block;margin:6px 0;">Or provide an Image URL below:</small>
                                    <input type="url" name="image_url" placeholder="https://...">
                                </div>
                                <div class="form-group">
                                    <label>Target Click URL (Optional)</label>
                                    <input type="text" name="target_url" placeholder="/collections/1 or /products/5">
                                    <small class="text-muted">Where should users go when they click the ad?</small>
                                </div>
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
                                    <label class="toggle-switch">
                                        <input type="checkbox" name="is_active">
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span class="form-label" style="margin:0;">Set as Active Ad (Deactivates others)</span>
                                </div>

                                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px;">
                                    <button type="submit" class="btn btn-black">Add Ad</button>
                                    <button type="button" class="btn btn-ghost"
                                        onclick="closeModal('addPopupAd')">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- EDIT POPUP AD MODAL -->
                    <div class="modal-bg" id="editPopupAd">
                        <div class="modal" style="max-width:560px;">
                            <div class="modal-hd">
                                <h3>Edit Popup Ad</h3>
                                <button class="modal-close" onclick="closeModal('editPopupAd')">✕</button>
                            </div>
                            <form id="editPopupAdForm" method="POST" enctype="multipart/form-data">
                                <div class="form-group">
                                    <label>Ad Title *</label>
                                    <input type="text" name="title" id="ePTitle" required>
                                </div>
                                <div class="form-group">
                                    <label>Image/Video Upload *</label>
                                    <input type="file" name="image_file" accept="image/*,video/*">
                                    <small style="display:block;margin:6px 0;">Or provide an Image URL below:</small>
                                    <input type="url" name="image_url" id="ePImage">
                                </div>
                                <div class="form-group">
                                    <label>Target Click URL</label>
                                    <input type="text" name="target_url" id="ePTarget">
                                </div>

                                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px;">
                                    <button type="submit" class="btn btn-black">Save Changes</button>
                                    <button type="button" class="btn btn-ghost"
                                        onclick="closeModal('editPopupAd')">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <script>
                        function openEditPopupAd(id, title, imageUrl, targetUrl) {
                            document.getElementById('editPopupAdForm').action = '/admin/popup-ads/edit/' + id;
                            document.getElementById('ePTitle').value = title;
                            document.getElementById('ePImage').value = imageUrl;
                            document.getElementById('ePTarget').value = targetUrl;
                            openModal('editPopupAd');
                        }
                    </script>

                    <%- include('_footer') %>