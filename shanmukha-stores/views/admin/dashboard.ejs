<%- include('_header') %>

<style>
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .dash-header h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #1A1A1A;
    }
    .dash-date-picker {
        background: #EAE3DE;
        color: #6C5B51;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .dash-filter-select {
        background: #F5F5F5;
        border: none;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #737373;
        outline: none;
        cursor: pointer;
    }
    .chart-container {
        position: relative;
        width: 100%;
    }
    .stat-diff {
        font-size: 12px;
        color: #A3A3A3;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    .stat-diff span {
        color: #1A1A1A;
    }
</style>

<div class="dash-header">
    <h2>Welcome back, <%= user.name || 'Admin' %></h2>

</div>

<!-- STATS CARDS -->
<div class="stats-row-custom" style="margin-bottom: 24px;">
    <!-- Income -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFF6F0; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/analytics'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Income</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8A78A" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><polyline points="21 3 21 8 16 8"></polyline></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;">₹<%= stats.revenue %></div>
        <div class="stat-diff">↑ <span>12%</span> with last month</div>
    </div>
    
    <!-- Orders -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/orders'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Orders</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFF6F0; display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8A78A" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;"><%= stats.orders %></div>
        <div class="stat-diff">↑ <span>5%</span> with last month</div>
    </div>

    <!-- Average check -->
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/analytics'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: #1A1A1A;">Average check</div>
            <div style="width: 32px; height: 32px; border-radius: 8px; background: #FFF6F0; display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E8A78A" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
        </div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 700; color: #1A1A1A; margin-bottom: 8px;">₹<%= stats.avgOrderValue %></div>
        <div class="stat-diff">↑ <span>12%</span> with last month</div>
    </div>
</div>

<!-- CHARTS AREA -->
<div class="dashboard-charts-grid" style="margin-bottom: 24px;">
    <!-- LEFT COLUMN -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Product Sales Line Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Product sales</div>
                <select class="dash-filter-select">
                    <option>Weekly</option>
                    <option>Monthly</option>
                </select>
            </div>
            <div class="chart-container" style="height: 260px;">
                <canvas id="productSalesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Categories Doughnut Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Categories</div>
                <select class="dash-filter-select">
                    <option>Weekly</option>
                    <option>Monthly</option>
                </select>
            </div>
            <div class="chart-container" style="height: 200px;">
                <canvas id="categoriesChart"></canvas>
            </div>
        </div>

        <!-- Sales by City Bar Chart -->
        <div class="luxury-card" style="padding: 24px; background: #FFFFFF; border: none; border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="font-size: 16px; font-weight: 700; color: #1A1A1A;">Sales by city</div>
                <select class="dash-filter-select">
                    <option>Weekly</option>
                    <option>Monthly</option>
                </select>
            </div>
            <div class="chart-container" style="height: 150px;">
                <canvas id="cityChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ADDITIONAL STATS AND LISTS (Preserved old dashboard data) -->
<div class="stats-row-dynamic" style="margin-top: 24px;">
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/orders?status=Pending'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Pending Orders</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.pending %></div>
        <div style="font-size: 12px; color: #737373;">Awaiting fulfillment</div>
    </div>
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/products'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Total Products</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.products %></div>
        <div style="font-size: 12px; color: #737373;">In active catalog</div>
    </div>
    <% if (user.role==='admin' ) { %>
    <div class="luxury-card" style="cursor: pointer; padding: 24px; background: #FFFFFF; border: none; border-radius: 16px; display: flex; flex-direction: column;" onclick="window.location.href='/admin/users'">
        <div style="font-size: 15px; font-weight: 600; color: #1A1A1A; margin-bottom: 12px;">Total Users</div>
        <div style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px;"><%= stats.users %></div>
        <div style="font-size: 12px; color: #737373;">Registered patrons</div>
    </div>
    <% } %>
</div>

<div class="<%= user.role === 'admin' ? 'grid-2' : 'grid-1' %>" style="gap:24px; margin-top:24px;">
    <!-- RECENT ORDERS -->
    <div class="luxury-card" style="padding:0; border:none; box-shadow: var(--shadow-sm); border-radius:16px; overflow:hidden;">
        <div class="card-hd" style="padding:24px; background: var(--surface); border-bottom: 1px solid var(--line);">
            <h3 class="luxury-text" style="font-size:16px; margin:0;">Recent Acquisitions</h3>
            <a href="/admin/orders" class="btn btn-ghost btn-sm" style="border-radius:8px;">View Full Registry</a>
        </div>
        <div class="tbl-wrap">
            <table style="border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="background: var(--gray-50);">
                        <th style="padding:15px 24px;">Ref #</th>
                        <th>Patron</th>
                        <th>Valuation</th>
                        <th style="padding-right:24px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% (recentOrders || []).forEach(function(o) { %>
                        <tr style="transition: background 0.3s; cursor: pointer;" onclick="window.location.href='/admin/orders/<%= o.id %>'">
                            <td style="padding:15px 24px; font-weight:600; color:var(--emerald);">#<%= o.id %></td>
                            <td style="font-weight:500;"><%= user.role==='admin' ? o.user_name : 'Staff Member ' + o.id %></td>
                            <td style="font-weight:600;">₹<%= Number(o.total_amount).toLocaleString('en-IN') %></td>
                            <td style="padding-right:24px;">
                                <% if(o.status==='Delivered' ) { %>
                                    <span class="badge bg-green">Fulfilled</span>
                                <% } else if(o.status==='Pending' ) { %>
                                    <span class="badge bg-orange">Awaiting</span>
                                <% } else if(o.status==='Cancelled' ) { %>
                                    <span class="badge bg-red">Rescinded</span>
                                <% } else { %>
                                    <span class="badge bg-blue"><%= o.status %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- CURATOR ACTIVITY -->
    <div class="curator-activity luxury-card" style="cursor: pointer; padding:0; border:none; border-radius:16px; overflow:hidden;" onclick="window.location.href='/admin/staff'">
        <div class="card-hd" style="padding:24px; background: var(--surface); border-bottom: 1px solid var(--line);">
            <h3 style="font-size:16px; margin:0; font-family: 'Plus Jakarta Sans', sans-serif;">Curator Activity</h3>
        </div>
        <div class="activity-list" style="padding:24px; max-height: 400px; overflow-y: auto;">
            <% if(typeof activities !=='undefined' && activities && activities.length> 0) { %>
                <% activities.forEach(act=> { %>
                    <div class="activity-item" style="display:flex; gap:12px; margin-bottom:16px;">
                        <div class="act-point" style="width:8px; height:8px; border-radius:50%; background:#E8A78A; margin-top:6px; flex-shrink:0;"></div>
                        <div class="act-content">
                            <div class="act-title" style="font-size:13px; color:#1A1A1A;"><strong><%= act.user_name %></strong> <%= act.action %></div>
                            <div class="act-meta" style="font-size:11px; color:#A3A3A3; margin-top:4px;"><%= new Date(act.created_at).toLocaleTimeString() %> • <%= act.details.name || act.details.email || '' %></div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="empty-msg" style="text-align:center; color:#A3A3A3; font-size:13px;">No recent activity.</p>
            <% } %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Data from Backend
    const chartsData = <%- JSON.stringify(typeof chartsData !== 'undefined' ? chartsData : { revenueByDay: [], revenueByCategory: [], salesByCity: [] }) %>;
    
    Chart.defaults.font.family = "'Manrope', sans-serif";
    Chart.defaults.color = "#A3A3A3";
    
    // Fallbacks
    const hasSalesData = chartsData.revenueByDay && chartsData.revenueByDay.length > 0;
    const salesLabels = hasSalesData ? chartsData.revenueByDay.map(d => d.day) : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const salesData = hasSalesData ? chartsData.revenueByDay.map(d => Number(d.revenue)) : [1200, 1900, 1500, 2500, 2200, 3000, 2800];

    const hasCatData = chartsData.revenueByCategory && chartsData.revenueByCategory.length > 0;
    const doughnutLabels = hasCatData ? chartsData.revenueByCategory.map(d => d.category) : ['Decor', 'Essentials', 'Other'];
    const doughnutData = hasCatData ? chartsData.revenueByCategory.map(d => Number(d.count)) : [45, 35, 20];

    const hasCityData = chartsData.salesByCity && chartsData.salesByCity.length > 0;
    const cityLabels = hasCityData ? chartsData.salesByCity.map(d => d.city) : ['Delhi', 'Mumbai', 'Bangalore'];
    const cityData = hasCityData ? chartsData.salesByCity.map(d => Number(d.count)) : [120, 80, 50];

    // 1. Product Sales (Line Chart)
    const ctxSales = document.getElementById('productSalesChart').getContext('2d');
    const gradientSales = ctxSales.createLinearGradient(0, 0, 0, 300);
    gradientSales.addColorStop(0, 'rgba(232, 167, 138, 0.4)');
    gradientSales.addColorStop(1, 'rgba(232, 167, 138, 0.0)');
    
    new Chart(ctxSales, {
        type: 'line',
        data: {
            labels: salesLabels,
            datasets: [{
                label: 'Revenue',
                data: salesData,
                borderColor: '#E8A78A',
                backgroundColor: gradientSales,
                borderWidth: 3,
                tension: 0.4, // Curved line
                fill: true,
                pointBackgroundColor: '#FFFFFF',
                pointBorderColor: '#E8A78A',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1A1A1A',
                    padding: 12,
                    titleFont: { size: 13 },
                    bodyFont: { size: 14, weight: 'bold' },
                    displayColors: false,
                    callbacks: {
                        label: function(context) { return '₹' + context.parsed.y; }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#F0F0F0', drawBorder: false },
                    border: { display: false }
                },
                x: {
                    grid: { display: false },
                    border: { display: false }
                }
            }
        }
    });

    // 2. Categories (Doughnut Chart)
    const ctxCategories = document.getElementById('categoriesChart').getContext('2d');
    new Chart(ctxCategories, {
        type: 'doughnut',
        data: {
            labels: doughnutLabels,
            datasets: [{
                data: doughnutData,
                backgroundColor: ['#EAE3DE', '#E8A78A', '#A39994', '#F8F8F8', '#D6CDC7'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: {
                    position: 'right',
                    labels: {
                        usePointStyle: true,
                        boxWidth: 8,
                        padding: 15,
                        font: { size: 11, weight: '500' }
                    }
                }
            }
        }
    });

    // 3. Sales by City (Horizontal Bar Chart)
    const ctxCity = document.getElementById('cityChart').getContext('2d');
    new Chart(ctxCity, {
        type: 'bar',
        data: {
            labels: cityLabels,
            datasets: [{
                label: 'Orders',
                data: cityData,
                backgroundColor: '#EAE3DE',
                borderRadius: 4,
                barThickness: 12
            }]
        },
        options: {
            indexAxis: 'y', // horizontal bar chart
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: {
                    display: false,
                    grid: { display: false }
                },
                y: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { font: { size: 11 }, autoSkip: false }
                }
            }
        }
    });
</script>

    <%- include('_footer') %>