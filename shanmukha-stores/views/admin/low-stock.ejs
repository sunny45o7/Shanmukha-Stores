<%- include('_header') %>

  <div class="page-hd">
    <div>
      <h2 class="luxury-text">⚠️ Low Stock Inventory</h2>
      <p>Premium provisions requiring replenishment</p>
    </div>

    <form method="GET" action="/admin/products/low-stock" class="glass"
      style="display:flex; align-items:center; gap:12px; padding: 12px 20px; border-radius: 12px; border: 1px solid var(--border);">
      <label
        style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:var(--gray-500);">Alert
        Threshold</label>
      <input type="number" name="threshold" value="<%= (typeof threshold !== 'undefined') ? threshold : 10 %>" min="1"
        max="100"
        style="padding:8px 12px; border:1px solid var(--border); border-radius:8px; width:70px; font-weight:600;">
      <button type="submit" class="btn btn-black btn-sm" style="border-radius:20px; padding:8px 18px;">Update</button>
    </form>
  </div>

  <% if (typeof products==='undefined' || products.length===0) { %>
    <div class="luxury-card" style="text-align:center; padding:80px 40px;">
      <div style="font-size:48px; margin-bottom:20px;">✨</div>
      <h3 class="luxury-text">Impeccable Inventory</h3>
      <p>All collections are currently well-stocked for our discerning clientele.</p>
    </div>
    <% } else { %>

      <div class="alert"
        style="background:var(--orange-bg); border: 1px solid rgba(211, 84, 0, 0.1); border-radius:12px; color:var(--orange); box-shadow: var(--shadow-sm);">
        <strong style="margin-right:8px;">⚠️ High Attention Required:</strong>
        <%= products.length %> items are below the threshold.
      </div>

      <div class="luxury-card" style="padding:0; border:none; box-shadow: var(--shadow-md);">
        <div class="tbl-wrap">
          <table style="border-radius:12px; overflow:hidden;">
            <thead>
              <tr style="background: var(--gray-100);">
                <th style="padding:18px 24px;">Product Heritage</th>
                <th>Category</th>
                <th>Acquisition Price</th>
                <th>Current Stock</th>
                <th>Status</th>
                <th style="text-align:right; padding-right:24px;">Management</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function(p) { %>
                <tr class="inventory-row"
                  style="background: <%= p.stock === 0 ? 'rgba(153, 27, 27, 0.03)' : 'transparent' %>;">
                  <td style="padding:16px 24px;">
                    <div style="display:flex; align-items:center; gap:15px;">
                      <% if (p.image) { %>
                        <img src="<%= p.image %>" class="prod-img"
                          style="width:50px; height:50px; border-radius:10px; border: 1px solid var(--border);">
                        <% } else { %>
                          <div
                            style="width:50px; height:50px; background:var(--gray-100); border-radius:10px; display:flex; align-items:center; justify-content:center; color:var(--gray-400);">
                            📦</div>
                          <% } %>
                            <div>
                              <strong
                                style="display:block; color:var(--black); font-size:14px; font-family:'Playfair Display', serif;">
                                <%= p.name %>
                              </strong>
                              <span
                                style="font-size:11px; color:var(--gray-400); text-transform:uppercase; letter-spacing:0.5px;">ID:
                                #<%= p.id %></span>
                            </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-gray" style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px;">
                      <%= p.category_name || 'Bespoke' %>
                    </span>
                  </td>
                  <td style="font-weight:600; color:var(--gray-700);">₹<%= Number(p.price).toLocaleString('en-IN') %>
                  </td>
                  <td>
                    <span
                      style="font-weight:700; font-size:15px; color:<%= p.stock === 0 ? 'var(--red)' : 'var(--orange)' %>;">
                      <%= p.stock %> <span style="font-size:12px; font-weight:500; color:var(--gray-400);">units</span>
                    </span>
                  </td>
                  <td>
                    <% if (p.stock===0) { %>
                      <span class="badge bg-red" style="padding:4px 12px;">Depleted</span>
                      <% } else { %>
                        <span class="badge bg-orange" style="padding:4px 12px;">Low Reserve</span>
                        <% } %>
                  </td>
                  <td style="text-align:right; padding-right:24px;">
                    <a href="/admin/products/edit/<%= p.id %>" class="btn btn-black btn-sm"
                      style="border-radius:20px; text-transform:uppercase; font-size:10px; letter-spacing:1px;">Update
                      Registry</a>
                  </td>
                </tr>
                <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <% } %>

        <%- include('_footer') %>