<%- include('_header') %>

    <% if(success) { %>
        <div class="alert alert-ok">✅ <%= success %>
        </div>
        <% } %>
            <% if(error) { %>
                <div class="alert alert-err">❌ <%= error %>
                </div>
                <% } %>

                    <div class="page-hd">
                        <div>
                            <h2>Collections</h2>
                            <p>Manage product collections and group similar items</p>
                        </div>
                        <button class="btn btn-black" onclick="openModal('addCollection')">+ Add Collection</button>
                    </div>

                    <div class="card">
                        <div class="tbl-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Image</th>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Products</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% collections.forEach(c=> { %>
                                        <tr>
                                            <td>
                                                <img src="<%= c.image || '/images/placeholder.png' %>"
                                                    style="width:50px;height:50px;object-fit:cover;border-radius:7px;background:var(--gray-100);"
                                                    onerror="this.style.opacity='0'">
                                            </td>
                                            <td style="font-weight:700;color:var(--black);">
                                                <%= c.name %>
                                            </td>
                                            <td
                                                style="color:var(--gray-500);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                                <%= c.description || '—' %>
                                            </td>
                                            <td><span class="badge bg-blue">
                                                    <%= c.productIds.length %> Items
                                                </span></td>
                                            <td>
                                                <% if(c.is_active) { %>
                                                    <span class="badge bg-green">Active</span>
                                                    <% } else { %>
                                                        <span class="badge bg-gray">Hidden</span>
                                                        <% } %>
                                            </td>
                                            <td>
                                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                                    <button class="btn btn-blue btn-sm" data-id="<%= c.id %>"
                                                        data-name="<%= c.name %>" data-desc="<%= c.description || '' %>"
                                                        data-image="<%= c.image || '' %>"
                                                        data-products="<%= JSON.stringify(c.productIds) %>"
                                                        onclick="openEditCollection(this.dataset.id, this.dataset.name, this.dataset.desc, this.dataset.image, JSON.parse(this.dataset.products))">Edit</button>
                                                    <form action="/admin/collections/toggle/<%= c.id %>" method="POST">
                                                        <button type="submit" class="btn btn-ghost btn-sm">
                                                            <%= c.is_active ? 'Hide' : 'Show' %>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/collections/delete/<%= c.id %>" method="POST"
                                                        onsubmit="return confirm('Delete this collection?')">
                                                        <button type="submit" class="btn btn-red btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% if(!collections.length) { %>
                                                <tr>
                                                    <td colspan="6">
                                                        <div class="empty">
                                                            <div class="big">📦</div>
                                                            <h3>No collections yet</h3>
                                                            <p>Create collections to group related products</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ADD COLLECTION MODAL -->
                    <div class="modal-bg" id="addCollection">
                        <div class="modal">
                            <div class="modal-hd">
                                <h3>Add Collection</h3>
                                <button class="modal-close" onclick="closeModal('addCollection')">✕</button>
                            </div>
                            <form action="/admin/collections/add" method="POST">
                                <div class="form-group">
                                    <label>Name *</label>
                                    <input type="text" name="name" required placeholder="e.g. Summer Collection">
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea class="inp" name="description"
                                        placeholder="A short description about this collection"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Banner Image URL</label>
                                    <input type="url" name="image" placeholder="https://...">
                                </div>

                                <div class="form-group">
                                    <label>Select Products</label>
                                    <div
                                        style="max-height: 200px; overflow-y: auto; border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: #fafafa;">
                                        <% allProducts.forEach(p=> { %>
                                            <label
                                                style="display:flex; align-items:center; gap:8px; font-weight:500; color:var(--text); cursor:pointer; margin-bottom:6px;">
                                                <input type="checkbox" name="product_ids" value="<%= p.id %>"
                                                    style="width:auto; min-height:initial;">
                                                <%= p.name %>
                                            </label>
                                            <% }) %>
                                    </div>
                                </div>

                                <label
                                    style="display:flex;align-items:center;gap:8px;margin-bottom:16px;cursor:pointer;font-size:13px;font-weight:600;">
                                    <input type="checkbox" name="is_active" checked
                                        style="width:16px;min-height:initial;padding:0;">
                                    Active
                                </label>

                                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px;">
                                    <button type="submit" class="btn btn-black">Create Collection</button>
                                    <button type="button" class="btn btn-ghost"
                                        onclick="closeModal('addCollection')">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- EDIT COLLECTION MODAL -->
                    <div class="modal-bg" id="editCollection">
                        <div class="modal">
                            <div class="modal-hd">
                                <h3>Edit Collection</h3>
                                <button class="modal-close" onclick="closeModal('editCollection')">✕</button>
                            </div>
                            <form id="editCollectionForm" method="POST">
                                <div class="form-group">
                                    <label>Name *</label>
                                    <input type="text" name="name" id="eCName" required>
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea class="inp" name="description" id="eCDesc"></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Banner Image URL</label>
                                    <input type="url" name="image" id="eCImage">
                                </div>

                                <div class="form-group">
                                    <label>Select Products</label>
                                    <div
                                        style="max-height: 200px; overflow-y: auto; border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: #fafafa;">
                                        <% allProducts.forEach(p=> { %>
                                            <label
                                                style="display:flex; align-items:center; gap:8px; font-weight:500; color:var(--text); cursor:pointer; margin-bottom:6px;">
                                                <input class="eCProdCheckbox" type="checkbox" name="product_ids"
                                                    value="<%= p.id %>" style="width:auto; min-height:initial;">
                                                <%= p.name %>
                                            </label>
                                            <% }) %>
                                    </div>
                                </div>

                                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:6px;">
                                    <button type="submit" class="btn btn-black">Save Changes</button>
                                    <button type="button" class="btn btn-ghost"
                                        onclick="closeModal('editCollection')">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <script>
                        function openEditCollection(id, name, desc, image, productIds) {
                            document.getElementById('editCollectionForm').action = '/admin/collections/edit/' + id;
                            document.getElementById('eCName').value = name;
                            document.getElementById('eCDesc').value = desc;
                            document.getElementById('eCImage').value = image;

                            document.querySelectorAll('.eCProdCheckbox').forEach(cb => {
                                cb.checked = productIds.includes(parseInt(cb.value));
                            });

                            openModal('editCollection');
                        }
                    </script>

                    <%- include('_footer') %>