      </div><!-- end admin-content -->
    </main>
  </div>

  <script>
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('show');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('show');
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-bg.show').forEach((m) => m.classList.remove('show'));
        const wrap = document.getElementById('notifWrap');
        const toggle = document.getElementById('notifToggle');
        if (wrap) wrap.classList.remove('open');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      }
    });

    (function () {
      const sidebar = document.getElementById('adminSidebar');
      const panelToggle = document.getElementById('panelMobileToggle');
      const layout = document.querySelector('.admin-layout');

      const syncMenuButton = () => {
        if (!sidebar || !panelToggle) return;
        panelToggle.setAttribute('aria-expanded', sidebar.classList.contains('menu-open') ? 'true' : 'false');
      };

      syncMenuButton();

      panelToggle?.addEventListener('click', () => {
        if (!sidebar) return;
        sidebar.classList.toggle('menu-open');
        syncMenuButton();
      });

      document.addEventListener('click', (e) => {
        if (!sidebar || !panelToggle) return;
        const isMobile = window.matchMedia('(max-width: 920px)').matches;
        if (!isMobile) return;
        if (sidebar.contains(e.target)) return;
        sidebar.classList.remove('menu-open');
        syncMenuButton();
      });

      if (sidebar && layout) {
        const desktopQuery = window.matchMedia('(min-width: 921px)');
        const setExpanded = (expanded) => {
          if (!desktopQuery.matches) {
            layout.classList.remove('sidebar-expanded');
            return;
          }
          layout.classList.toggle('sidebar-expanded', expanded);
        };
        sidebar.addEventListener('mouseenter', () => setExpanded(true));
        sidebar.addEventListener('mouseleave', () => setExpanded(false));
        desktopQuery.addEventListener('change', () => setExpanded(false));
      }
    })();

    (function () {
      const notifWrap = document.getElementById('notifWrap');
      const notifToggle = document.getElementById('notifToggle');
      if (!notifWrap || !notifToggle) return;

      notifToggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const open = notifWrap.classList.toggle('open');
        notifToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (notifWrap.contains(e.target)) return;
        notifWrap.classList.remove('open');
        notifToggle.setAttribute('aria-expanded', 'false');
      });
    })();

    document.querySelectorAll('.modal-bg').forEach((modalBg) => {
      modalBg.addEventListener('click', (e) => {
        if (e.target === modalBg) modalBg.classList.remove('show');
      });
    });
  </script>
</body>
</html>

