<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> - Shanmukha Admin
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #FAFAFA;
      --panel: #FFFFFF;
      --surface: #FFFFFF;
      --surface-2: #FFF8F5;
      --text: #1A1A1A;
      --muted: #737373;
      --line: #F0F0F0;
      --line-soft: #F8F8F8;
      --accent: #E8A78A;
      --accent-soft: #FFF8F5;
      --success: #1f9d62;
      --warning: #c97f16;
      --danger: #ce3b4f;
      --radius-xl: 22px;
      --radius-lg: 16px;
      --radius-md: 12px;
      --radius-sm: 10px;
      --shadow-1: 0 4px 20px rgba(0, 0, 0, 0.03);
      --shadow-2: 0 12px 36px rgba(0, 0, 0, 0.06);
      --ease: 220ms cubic-bezier(.22, 1, .36, 1);
      --sidebar-bg: #2D2D2D;
      --sidebar-text: #A3A3A3;
      --sidebar-hover: rgba(255, 255, 255, 0.1);

      /* Compatibility aliases used across admin views */
      --black: #1A1A1A;
      --rich-black: #0F172A;
      --emerald: #1F9D62;
      --emerald-mid: #188A55;
      --gold: #E0A72F;
      --bone: #F7F8FB;
      --cream: #FFF8F5;
      --gray-50: #F8FAFC;
      --gray-100: #F1F5F9;
      --gray-300: #CBD5E1;
      --gray-400: #94A3B8;
      --gray-500: #64748B;
      --gray-600: #475569;
      --gray-700: #334155;
      --green-bg: #E8F8F0;
      --orange: #9A5D0B;
      --orange-bg: #FFF4DF;
      --red: #B42335;
      --border: #F0F0F0;
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.02);
      --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 12px 36px rgba(0, 0, 0, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: 'Manrope', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    .admin-layout {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 260px 1fr;
      transition: grid-template-columns var(--ease);
      background: var(--bg);
    }

    .admin-layout.sidebar-expanded {
      grid-template-columns: 260px 1fr;
    }

    .admin-sidebar {
      background: var(--sidebar-bg);
      border: none;
      border-radius: 0;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding: 24px 16px;
      gap: 10px;
      position: sticky;
      top: 0;
      height: 100vh;
      z-index: 30;
      width: 260px;
      overflow: visible;
    }

    .admin-sidebar:hover {
      width: 260px;
      align-items: stretch;
      padding: 24px 16px;
      box-shadow: none;
    }

    .admin-layout.sidebar-expanded .admin-sidebar {
      width: auto;
      align-items: stretch;
      padding: 24px 16px;
      box-shadow: none;
    }

    .sidebar-brand {
      width: auto;
      height: auto;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      flex-shrink: 0;
      position: relative;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.15em;
      color: #FFFFFF;
      text-align: center;
      margin-bottom: 20px;
    }

    .sidebar-brand h1,
    .sidebar-brand span {
      display: none;
    }

    .sidebar-user {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 10px;
      margin-bottom: 10px;
    }
    .sidebar-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 800;
    }
    .sidebar-user-name {
      font-size: 14px;
      font-weight: 600;
      color: #E0E0E0;
    }

    .panel-mobile-toggle {
      display: none;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--text);
      border-radius: 999px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 700;
    }

    .sidebar-nav-wrap {
      flex: 1;
      width: 100%;
      min-height: 0;
      display: flex;
      align-items: stretch;
      justify-content: center;
    }

    .nav-scroll-btn {
      display: none !important;
    }

    .sidebar-nav {
      width: 100%;
      overflow-y: auto;
      padding-right: 2px;
    }

    .sidebar-nav::-webkit-scrollbar {
      width: 4px;
    }

    .sidebar-nav::-webkit-scrollbar-thumb {
      background: #d5dbe8;
      border-radius: 999px;
    }

    .nav-group {
      display: grid;
      gap: 7px;
    }

    .nav-group-label {
      display: none;
    }

    .nav-link {
      width: 100%;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      padding: 0 12px;
      border-radius: 8px;
      border: none;
      color: var(--sidebar-text);
      transition: all var(--ease);
      position: relative;
    }

    .nav-link .icon {
      display: inline-grid;
      place-items: center;
      width: 20px;
      height: 20px;
      font-size: 15px;
      line-height: 1;
    }

    .nav-link .nav-text {
      opacity: 1;
      max-width: 180px;
      overflow: hidden;
      white-space: nowrap;
      font-size: 13px;
      font-weight: 600;
      transition: none;
    }

    .nav-link::after {
      display: none !important;
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: transparent;
      color: #fff;
    }

    .nav-link.active {
      background: #4A4A4A;
      border-color: transparent;
      color: #fff;
      box-shadow: none;
    }

    .admin-sidebar:hover .sidebar-foot button {
      font-size: 12px;
    }

    .sidebar-foot {
      width: 100%;
      padding-top: 8px;
      border-top: 1px solid var(--line-soft);
    }

    .sidebar-foot button {
      width: 100%;
      min-height: 42px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: transparent;
      color: var(--sidebar-text);
      font-size: 12px;
      font-weight: 700;
      transition: all var(--ease);
    }

    .sidebar-foot button:hover {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.05);
    }

    .admin-main {
      background: var(--bg);
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow: hidden;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .topbar {
      min-height: 78px;
      background: transparent;
      border-bottom: 1px solid var(--line-soft);
      padding: 24px;
      display: grid;
      grid-template-columns: auto minmax(220px, 1fr) auto;
      gap: 16px;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .topbar-left h2 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 23px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .topbar-left p {
      margin-top: 4px;
      font-size: 12px;
      color: var(--muted);
      font-weight: 500;
    }

    .topbar-search {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px 12px;
      min-height: 46px;
    }

    .topbar-search span {
      color: #6b7280;
      font-size: 14px;
    }

    .topbar-search input {
      border: none;
      outline: none;
      width: 100%;
      background: transparent;
      font-size: 13px;
      color: var(--text);
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      justify-self: end;
    }

    .topbar-pill {
      border: 1px solid #d8e7fd;
      color: #2367c8;
      background: #f2f8ff;
      border-radius: 999px;
      padding: 7px 12px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .02em;
      white-space: nowrap;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      border: 1px solid var(--line);
      background: #fff;
      color: #4b5563;
      display: inline-grid;
      place-items: center;
      font-size: 14px;
      transition: all var(--ease);
    }

    .icon-btn:hover {
      box-shadow: var(--shadow-1);
      color: var(--text);
    }

    .topbar-user {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 4px 10px 4px 4px;
      background: #fff;
    }

    .topbar-avatar {
      width: 31px;
      height: 31px;
      border-radius: 50%;
      background: linear-gradient(180deg, #4c83ff, #2f6be6);
      color: #fff;
      display: inline-grid;
      place-items: center;
      font-size: 12px;
      font-weight: 800;
    }

    .topbar-user-name {
      font-size: 12px;
      font-weight: 700;
      color: #111827;
      max-width: 130px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .notif-wrap {
      position: relative;
    }

    .notif-btn {
      width: 40px;
      height: 40px;
      border-radius: 11px;
      border: 1px solid var(--line);
      background: #fff;
      color: #4b5563;
      display: inline-grid;
      place-items: center;
      font-size: 14px;
      position: relative;
      transition: all var(--ease);
    }

    .notif-btn:hover {
      box-shadow: var(--shadow-1);
    }

    .notif-badge {
      position: absolute;
      top: -5px;
      right: -5px;
      min-width: 17px;
      height: 17px;
      padding: 0 4px;
      border-radius: 999px;
      background: var(--danger);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      display: inline-grid;
      place-items: center;
    }

    .notif-menu {
      display: none;
      position: absolute;
      right: 0;
      top: calc(100% + 10px);
      width: min(360px, 92vw);
      max-height: 420px;
      overflow: auto;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 14px;
      box-shadow: var(--shadow-2);
      z-index: 50;
    }

    .notif-wrap.open .notif-menu {
      display: block;
    }

    .notif-item {
      padding: 11px 12px;
      border-bottom: 1px solid var(--line-soft);
    }

    .notif-item:last-child {
      border-bottom: none;
    }

    .notif-item h4 {
      font-size: 12px;
      margin-bottom: 3px;
    }

    .notif-item p {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .notif-item small {
      font-size: 10px;
      color: #9ca3af;
    }

    .admin-content {
      padding: 24px;
      animation: pageIn var(--ease);
      flex: 1;
    }

    @keyframes pageIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .page-hd {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 18px;
    }

    .page-hd h2 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #0f172a;
    }

    .page-hd p {
      margin-top: 6px;
      font-size: 13px;
      color: var(--muted);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      margin-bottom: 24px;
    }

    .stat-card,
    .card,
    .luxury-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow-1);
      transition: all var(--ease);
    }

    .stat-card:hover,
    .card:hover,
    .luxury-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.04);
    }

    .stat-card {
      padding: 24px;
    }

    .stat-icon {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .stat-label {
      font-size: 11px;
      color: #6b7280;
      margin-bottom: 4px;
      font-weight: 700;
      letter-spacing: .03em;
    }

    .stat-val {
      font-size: 26px;
      font-weight: 800;
      color: #111827;
      line-height: 1;
    }

    .card-hd {
      padding: 20px 24px;
      border-bottom: 1px solid var(--line-soft);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .card-hd h3 {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .card-body {
      padding: 24px;
    }

    .grid-1 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .tbl-wrap {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 640px;
    }

    th {
      text-align: left;
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: .02em;
      text-transform: uppercase;
      padding: 16px 20px;
      background: transparent;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }

    td {
      padding: 16px 20px;
      font-size: 14px;
      color: var(--text);
      border-bottom: 1px solid var(--line-soft);
      vertical-align: middle;
    }

    tbody tr:hover td {
      background: var(--surface-2);
    }

    tr:last-child td {
      border-bottom: none;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .02em;
    }

    .bg-green {
      background: #e8f8f0;
      color: #18794e;
    }

    .bg-orange {
      background: #fff4df;
      color: #9a5d0b;
    }

    .bg-red {
      background: #ffe9ed;
      color: #b42335;
    }

    .bg-blue {
      background: #eaf2ff;
      color: #205ec4;
    }

    .bg-gray {
      background: #eff2f6;
      color: #5b6475;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 36px;
      border-radius: 10px;
      border: 1px solid transparent;
      padding: 0 14px;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: .01em;
      transition: all var(--ease);
      cursor: pointer;
      white-space: nowrap;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-black {
      background: #1A1A1A;
      color: #fff;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    }

    .btn-black:hover {
      background: #333333;
    }

    .btn-green {
      background: #eaf8ef;
      color: #157347;
      border-color: #ccefd9;
    }

    .btn-red {
      background: #ffeef1;
      color: #b42335;
      border-color: #f7d2da;
    }

    .btn-blue {
      background: #eaf2ff;
      color: #205ec4;
      border-color: #cfe0ff;
    }

    .btn-ghost {
      background: #fff;
      color: #475467;
      border-color: var(--line);
    }

    .btn-secondary {
      background: #fff;
      color: #334155;
      border-color: #dbe1ea;
    }

    .btn.active {
      border-color: #bfd6fb;
      color: var(--accent);
      background: var(--accent-soft);
    }

    .btn-sm {
      min-height: 30px;
      padding: 0 11px;
      font-size: 11.5px;
      border-radius: 9px;
    }

    .inp,
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      min-height: 38px;
      border-radius: 10px;
      border: 1px solid var(--line);
      background: #fff;
      color: #111827;
      padding: 0 12px;
      font-size: 13px;
      outline: none;
      transition: all var(--ease);
    }

    textarea.inp,
    .form-group textarea {
      min-height: 96px;
      padding: 10px 12px;
      resize: vertical;
    }

    .inp:focus,
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: #b6d2fa;
      box-shadow: 0 0 0 4px rgba(47, 128, 237, 0.12);
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-size: 12px;
      font-weight: 700;
      color: #475467;
    }

    .search-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .search-box {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 10px;
      min-height: 38px;
      padding: 0 12px;
    }

    .search-box input {
      border: none;
      outline: none;
      background: transparent;
      min-width: 220px;
      font-size: 13px;
    }

    .alert {
      border-radius: 12px;
      border: 1px solid var(--line);
      padding: 10px 12px;
      margin-bottom: 14px;
      font-size: 12px;
      font-weight: 600;
    }

    .alert-ok {
      background: #eaf8ef;
      border-color: #ccefd9;
      color: #157347;
    }

    .alert-err {
      background: #fff1f3;
      border-color: #ffd5dc;
      color: #b42335;
    }

    .tiny {
      font-size: 11px;
      color: #6b7280;
    }

    .text-muted {
      color: #6b7280;
    }

    .meta {
      color: #64748b;
      font-size: 12px;
    }

    .summary {
      display: grid;
      gap: 8px;
    }

    .sum-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 13px;
    }

    .sheet {
      background: #fff;
      border: 1px solid var(--line-soft);
      border-radius: 12px;
      padding: 12px;
    }

    .pagination {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .page-btn {
      min-width: 34px;
      height: 34px;
      border-radius: 9px;
      border: 1px solid var(--line);
      background: #fff;
      display: inline-grid;
      place-items: center;
      font-size: 12px;
      font-weight: 700;
      color: #4b5563;
      transition: all var(--ease);
      text-decoration: none;
    }

    .page-btn.active {
      border-color: #bfd6fb;
      color: var(--accent);
      background: var(--accent-soft);
    }

    .page-btn.disabled {
      pointer-events: none;
      opacity: .45;
    }

    .empty {
      text-align: center;
      padding: 44px 20px;
      color: #6b7280;
    }

    .empty .big {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .modal-bg {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 32, 0.46);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 900;
      padding: 18px;
      backdrop-filter: blur(4px);
    }

    .modal-bg.show {
      display: flex;
    }

    .modal {
      width: min(660px, 96vw);
      max-height: calc(100vh - 36px);
      overflow: auto;
      background: #fff;
      border-radius: 16px;
      border: 1px solid var(--line);
      box-shadow: var(--shadow-2);
      padding: 18px;
      animation: modalIn var(--ease);
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(8px) scale(.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .modal-hd {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .modal-hd h3 {
      font-size: 16px;
      font-weight: 700;
    }

    .modal-close {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #fff;
      color: #6b7280;
      display: inline-grid;
      place-items: center;
    }

    .modal-close:hover {
      color: #111827;
      border-color: #d0d5dd;
    }

    .prod-img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
      background: #f3f4f6;
      border: 1px solid var(--line-soft);
    }

    .glass {
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--line);
      backdrop-filter: blur(6px);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 18, 32, 0.45);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 90;
      padding: 18px;
      backdrop-filter: blur(2px);
    }

    .modal-card-minimal {
      width: min(440px, 96vw);
      border-radius: 16px;
      border: 1px solid var(--line);
      background: #fff;
      box-shadow: var(--shadow-2);
      overflow: hidden;
    }

    .modal-hd-minimal {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid var(--line-soft);
    }

    .modal-hd-minimal h3 {
      font-size: 16px;
      font-weight: 700;
    }

    .modal-hd-minimal button {
      width: 30px;
      height: 30px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--gray-600);
    }

    .modal-form-minimal {
      display: grid;
      gap: 10px;
      padding: 16px;
    }

    .modal-form-minimal input {
      width: 100%;
      min-height: 38px;
      border-radius: 10px;
      border: 1px solid var(--line);
      padding: 0 12px;
      font-size: 13px;
    }

    .btn-black-minimal {
      min-height: 38px;
      border-radius: 10px;
      background: #111827;
      color: #fff;
      border: 1px solid #111827;
      font-size: 12px;
      font-weight: 700;
    }

    .btn-black-minimal:hover {
      background: #1f2937;
    }

    .luxury-text {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    @media (max-width: 1150px) {
      .topbar {
        grid-template-columns: 1fr;
        gap: 10px;
        align-items: stretch;
      }

      .topbar-actions {
        justify-self: start;
        flex-wrap: wrap;
      }

      .stats-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid-2 {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 920px) {
      .admin-layout {
        grid-template-columns: 1fr;
        padding: 10px;
        gap: 10px;
      }

      .panel-mobile-toggle {
        display: inline-flex;
      }

      .admin-sidebar {
        position: static;
        height: auto;
        border-radius: 16px;
        padding: 10px;
        width: auto;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }

      .sidebar-nav-wrap {
        display: none;
      }

      .admin-sidebar.menu-open .sidebar-nav-wrap {
        display: block;
        width: 100%;
        order: 4;
      }

      .sidebar-nav {
        max-height: 52vh;
        overflow: auto;
      }

      .nav-group {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
      }

      .nav-link {
        min-height: 58px;
        padding: 8px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
      }

      .nav-link::after {
        display: none;
      }

      .nav-link .icon {
        font-size: 18px;
      }

      .nav-link .nav-text {
        opacity: 0;
        max-width: 0;
      }

      .nav-link::before {
        content: attr(data-label);
        font-size: 10px;
        color: #475569;
        font-weight: 700;
        letter-spacing: .02em;
        line-height: 1;
      }

      .sidebar-foot {
        display: none;
        order: 5;
        border-top: none;
        padding-top: 0;
      }

      .admin-sidebar.menu-open .sidebar-foot {
        display: block;
      }

      .admin-main {
        border-radius: 16px;
      }

      .admin-content {
        padding: 14px;
      }

      .page-hd {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 620px) {
      .nav-group {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .topbar-user-name {
        display: none;
      }

      .search-box input {
        min-width: 130px;
      }

      .stats-row {
        grid-template-columns: 1fr;
      }

      table {
        min-width: 560px;
      }
    }

    /* Grid System & Layout Utilities */
    .row {
      display: flex;
      flex-wrap: wrap;
      margin-right: -12px;
      margin-left: -12px;
    }

    .row>* {
      flex-shrink: 0;
      width: 100%;
      max-width: 100%;
      padding-right: 12px;
      padding-left: 12px;
      margin-top: 0;
    }

    .col-12 {
      flex: 0 0 auto;
      width: 100%;
    }

    @media (min-width: 768px) {
      .col-md-3 {
        flex: 0 0 auto;
        width: 25%;
      }

      .col-md-4 {
        flex: 0 0 auto;
        width: 33.33333333%;
      }

      .col-md-5 {
        flex: 0 0 auto;
        width: 41.66666667%;
      }

      .col-md-6 {
        flex: 0 0 auto;
        width: 50%;
      }

      .col-md-8 {
        flex: 0 0 auto;
        width: 66.66666667%;
      }
    }

    @media (min-width: 992px) {
      .col-lg-12 {
        flex: 0 0 auto;
        width: 100%;
      }
    }

    .container-fluid {
      width: 100%;
      padding-right: 12px;
      padding-left: 12px;
      margin-right: auto;
      margin-left: auto;
    }

    .d-flex {
      display: flex !important;
    }

    .align-items-center {
      align-items: center !important;
    }

    .justify-content-between {
      justify-content: space-between !important;
    }

    .gap-2 {
      gap: 0.5rem !important;
    }

    .w-100 {
      width: 100% !important;
    }

    .mb-0 {
      margin-bottom: 0 !important;
    }

    .mb-3 {
      margin-bottom: 1rem !important;
    }

    .mt-1 {
      margin-top: 0.25rem !important;
    }

    .p-0 {
      padding: 0 !important;
    }

    /* Refined Table Aesthetics */
    .table {
      width: 100%;
      margin-bottom: 1rem;
      vertical-align: top;
      border-color: var(--line-soft);
    }

    .table th {
      background: var(--surface-2);
      color: var(--gray-600);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--line);
    }

    .table td {
      vertical-align: middle;
    }

    /* Animation Utilities */
    [data-animate="fadeUp"] {
      animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Payments Specific */
    .qr-preview-img {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      object-fit: contain;
      background: #fbfbfc;
      border: 1px solid var(--line);
      padding: 4px;
      transition: transform 0.2s;
    }

    .qr-preview-img:hover {
      transform: scale(3) translateX(15px);
      z-index: 100;
      position: relative;
    }

    .status-badge {
      padding: 0.4em 0.8em;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .bg-success {
      background-color: #e6f9f0 !important;
      color: #15803d !important;
    }

    .bg-danger {
      background-color: #fee2e2 !important;
      color: #b91c1c !important;
    }

    .bg-warning {
      background-color: #fef9c3 !important;
      color: #a16207 !important;
    }
  </style>
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand" title="Shanmukha Admin">
        SHANMUKHA
      </div>
      <div class="sidebar-user" title="<%= user && user.name ? user.name : 'Account' %>">
        <div class="sidebar-avatar">
          <%=user && user.name ? user.name.charAt(0).toUpperCase() : 'A' %>
        </div>
        <span class="sidebar-user-name">
          <%=user && user.name ? user.name : 'Account' %>
        </span>
      </div><button type="button" class="panel-mobile-toggle" id="panelMobileToggle" aria-expanded="false"
        aria-label="Toggle panel menu">Menu </button>
      <% const isStaffPanel=user && user.role==='staff' ; %>
        <div class="sidebar-nav-wrap"><button type="button" class="nav-scroll-btn" id="adminNavScrollLeft"
            aria-label="Scroll menu left">&lt;

          </button>
          <nav class="sidebar-nav" id="adminSidebarNav">
            <% if (isStaffPanel) { %>
              <div class="nav-group"><a href="/staff/dashboard"
                  class="nav-link <%= title==='Staff Dashboard'?'active':'' %>" data-label="Dashboard"
                  title="Dashboard"><span class="icon">D</span><span class="nav-text">Dashboard</span></a><a
                  href="/staff/orders" class="nav-link <%= title==='Staff Orders'?'active':'' %>" data-label="Orders"
                  title="Orders"><span class="icon">O</span><span class="nav-text">Orders</span></a><a
                  href="/staff/returns" class="nav-link <%= title==='Staff Returns'?'active':'' %>" data-label="Returns"
                  title="Returns"><span class="icon">R</span><span class="nav-text">Returns</span></a><a
                  href="/staff/payments" class="nav-link <%= title==='Payments'?'active':'' %>" data-label="Payments"
                  title="Payments"><span class="icon">P</span><span class="nav-text">Payments</span></a><a href="/"
                  target="_blank" class="nav-link" data-label="View Store" title="View Store"><span
                    class="icon">V</span><span class="nav-text">View Store</span></a></div>
              <% } else { %>
                <div class="nav-group"><a href="/admin/dashboard"
                    class="nav-link <%= title==='Dashboard'?'active':'' %>" data-label="Dashboard"
                    title="Dashboard"><span class="icon">D</span><span class="nav-text">Dashboard</span></a><a
                    href="/admin/analytics" class="nav-link <%= title==='Analytics'?'active':'' %>"
                    data-label="Analytics" title="Analytics"><span class="icon">A</span><span
                      class="nav-text">Analytics</span></a><a href="/admin/orders"
                    class="nav-link <%= title==='Orders'?'active':'' %>" data-label="Orders" title="Orders"><span
                      class="icon">O</span><span class="nav-text">Orders</span></a><a href="/admin/orders/cancelled"
                    class="nav-link <%= title==='Cancelled Orders'?'active':'' %>" data-label="Cancelled"
                    title="Cancelled Orders"><span class="icon">C</span><span class="nav-text">Cancelled
                      Orders</span></a><a href="/admin/payments" class="nav-link <%= title==='Payments'?'active':'' %>"
                    data-label="Payments" title="Payments"><span class="icon">P</span><span
                      class="nav-text">Payments</span></a><a href="/admin/products"
                    class="nav-link <%= title==='Products'?'active':'' %>" data-label="Products" title="Products"><span
                      class="icon">P</span><span class="nav-text">Products</span></a><a href="/admin/categories"
                    class="nav-link <%= title==='Categories'?'active':'' %>" data-label="Categories"
                    title="Categories"><span class="icon">G</span><span class="nav-text">Categories</span></a><a
                    href="/admin/offers" class="nav-link <%= title==='Offers'?'active':'' %>" data-label="Offers"
                    title="Offers"><span class="icon">F</span><span class="nav-text">Offers</span></a><a
                    href="/admin/collections" class="nav-link <%= title==='Collections'?'active':'' %>"
                    data-label="Collections" title="Collections"><span class="icon">C</span><span
                      class="nav-text">Collections</span></a><a href="/admin/popup-ads"
                    class="nav-link <%= title==='Popup Ads'?'active':'' %>" data-label="Popup Ads"
                    title="Popup Ads"><span class="icon">A</span><span class="nav-text">Popup Ads</span></a><a
                    href="/admin/collaborations" class="nav-link <%= title==='Collaborations'?'active':'' %>"
                    data-label="Collaborations" title="Collaborations"><span class="icon">L</span><span
                      class="nav-text">Collaborations</span></a><a href="/admin/banners"
                    class="nav-link <%= title==='Banners'?'active':'' %>" data-label="Banners" title="Banners"><span
                      class="icon">B</span><span class="nav-text">Banners</span></a><a href="/admin/returns"
                    class="nav-link <%= title==='Returns'?'active':'' %>" data-label="Returns" title="Returns"><span
                      class="icon">R</span><span class="nav-text">Returns</span></a><a href="/admin/users"
                    class="nav-link <%= title==='Users'?'active':'' %>" data-label="Users" title="Users"><span
                      class="icon">U</span><span class="nav-text">Users</span></a><a href="/admin/staff-management"
                    class="nav-link <%= title==='Staff Management'?'active':'' %>" data-label="Staff"
                    title="Staff Management"><span class="icon">S</span><span class="nav-text">Staff
                      Management</span></a><a href="/staff/dashboard"
                    class="nav-link <%= title==='Staff Dashboard' ? 'active' : '' %>" data-label="Staff Panel"
                    title="Staff Panel"><span class="icon">T</span><span class="nav-text">Staff Panel</span></a><a
                    href="/admin/settings" class="nav-link <%= title==='Settings'?'active':'' %>" data-label="Settings"
                    title="Settings"><span class="icon">E</span><span class="nav-text">Settings</span></a><a href="/"
                    target="_blank" class="nav-link" data-label="View Store" title="View Store"><span
                      class="icon">V</span><span class="nav-text">View Store</span></a></div>
                <% } %>
          </nav><button type="button" class="nav-scroll-btn" id="adminNavScrollRight"
            aria-label="Scroll menu right">&gt;

          </button>
        </div>
        <div class="sidebar-foot">
          <form action="/auth/logout" method="POST"><button type="submit">Sign Out</button></form>
        </div>
    </aside>
    <main class="admin-main">
      <div class="topbar">
        <div class="topbar-left">
          <h2>
            <%=title %>
          </h2>
          <p>
            <%=user && user.role==='admin' ? 'Admin Workspace' : 'Staff Workspace' %>
          </p>
        </div><label class="topbar-search" aria-label="Search admin"><span>S</span><input type="text"
            placeholder="Search orders, users, products..." aria-label="Search"></label>
        <div class="topbar-actions"><span class="topbar-pill">
            <%=user && user.role==='admin' ? 'Admin' : 'Staff' %>
          </span>
          <div class="notif-wrap" id="notifWrap"><button class="notif-btn" type="button" id="notifToggle"
              aria-expanded="false" aria-label="Notifications">N <% if (typeof unreadNotificationCount !=='undefined' &&
                unreadNotificationCount> 0) {
                %><span class="notif-badge">
                  <%=unreadNotificationCount>99 ? '99+': unreadNotificationCount %>
                </span>
                <% } %></button>
            <div class="notif-menu" id="notifMenu">
              <% if (typeof notifications !=='undefined' && notifications.length> 0) {
                %><% notifications.forEach(n=> {
                  %> <div class="notif-item">
                    <h4>
                      <%=n.title %>
                    </h4>
                    <p>
                      <%=n.message %>
                    </p> <small>
                      <%=new Date(n.created_at).toLocaleString('en-IN') %>
                    </small>
                  </div>
                  <% }) %>
                    <% if (typeof unreadNotificationCount !=='undefined' && unreadNotificationCount> 0) {
                      %><form method="POST" action="/notifications/read-all"
                        style="padding:10px 12px;border-top:1px solid var(--line-soft);"><button type="submit"
                          class="btn btn-ghost btn-sm" style="width:100%;">Mark All Read</button></form>
                      <% } %>
                        <% } else { %>
                          <div class="notif-item">
                            <p>No notifications yet.</p>
                          </div>
                          <% } %>
            </div>
          </div>

        </div>
      </div>
      <div class="admin-content">
