<%- include('./partials/navbar') %>

<div class="page-header">
  <div class="section-label">Shop</div>
  <h1>All Products</h1>
  <p>Fresh &amp; organic goodness, delivered to you</p>
</div>

<section class="products-section products-page">
  <form method="GET" action="/products" id="filterForm">
    <div class="filter-bar">
      <div class="filter-search">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          name="search"
          placeholder="Search products..."
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          id="searchInput"
        >
      </div>

      <select name="category" class="filter-select" onchange="document.getElementById('filterForm').submit()">
        <option value="">All Categories</option>
        <% if (typeof categories !== 'undefined') { categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= (typeof selectedCategory !== 'undefined' && String(selectedCategory) === String(c.id)) ? 'selected' : '' %>><%= c.name %></option>
        <% }) } %>
      </select>

      <select name="sort" class="filter-select" onchange="document.getElementById('filterForm').submit()">
        <option value="">Sort: Default</option>
        <option value="price_asc" <%= (typeof sort !== 'undefined' && sort === 'price_asc') ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price_desc" <%= (typeof sort !== 'undefined' && sort === 'price_desc') ? 'selected' : '' %>>Price: High to Low</option>
        <option value="name_asc" <%= (typeof sort !== 'undefined' && sort === 'name_asc') ? 'selected' : '' %>>Name: A to Z</option>
      </select>

      <button type="submit" class="btn-primary btn-sm filter-apply-btn">Apply</button>

      <% if ((typeof search !== 'undefined' && search) || (typeof selectedCategory !== 'undefined' && selectedCategory) || (typeof sort !== 'undefined' && sort)) { %>
        <a href="/products" class="btn-secondary btn-sm filter-apply-btn">Clear</a>
      <% } %>
    </div>
  </form>

  <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
    <div class="categories-row">
      <a href="/products" class="category-pill <%= (!selectedCategory) ? 'active' : '' %>">All</a>
      <% categories.forEach(c => { %>
        <a href="/products?category=<%= c.id %>" class="category-pill <%= (String(selectedCategory) === String(c.id)) ? 'active' : '' %>"><%= c.name %></a>
      <% }) %>
    </div>
  <% } %>

  <% if (typeof totalCount !== 'undefined') { %>
    <p class="results-count">
      Showing <strong><%= products.length %></strong> of <strong><%= totalCount %></strong> products
    </p>
  <% } %>

  <% if (products && products.length > 0) { %>
    <div class="products-grid">
      <% products.forEach((p) => { %>
        <div class="product-card">
          <div class="product-image">
            <a href="/products/<%= p.id %>">
              <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" onerror="this.src='/images/placeholder.png'">
            </a>

            <% if (p.stock === 0) { %>
              <span class="product-badge sale">Sold Out</span>
            <% } %>

            <form action="/wishlist/toggle/<%= p.id %>" method="POST" class="wishlist-toggle-form wishlist-form-inline" data-product-id="<%= p.id %>">
              <button type="submit" class="wishlist-btn" title="Wishlist">♡</button>
            </form>
          </div>

          <div class="product-info">
            <p class="product-category-tag"><%= p.category_name || 'Grocery' %></p>
            <h3 class="product-name"><a href="/products/<%= p.id %>"><%= p.name %></a></h3>
            
            <div class="product-rating small">
              <span class="stars" style="--rating: <%= p.average_rating || 0 %>;"></span>
              <% if (p.review_count > 0) { %>
                <span class="rating-text">(<%= p.review_count %>)</span>
              <% } %>
            </div>

            <p class="product-price">&#8377;<%= Number(p.effective_price || p.price).toLocaleString('en-IN') %>
              <% if (p.price_type === 'kg') { %>
                <span class="price-unit-note">per kg</span>
              <% } else { %>
                <span class="price-unit-note">per unit</span>
              <% } %>
            </p>
            <% if (p.stock === 0) { %>
              <div class="out-of-stock-label">Out of Stock</div>
            <% } else { %>
              <form action="/cart/add/<%= p.id %>" method="POST">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="add-cart-btn">Add to Cart</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="pagination">
        <a href="/products?page=<%= currentPage - 1 %>&search=<%= search||'' %>&category=<%= selectedCategory||'' %>&sort=<%= sort||'' %>" class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>">‹</a>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/products?page=<%= i %>&search=<%= search||'' %>&category=<%= selectedCategory||'' %>&sort=<%= sort||'' %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
        <% } %>
        <a href="/products?page=<%= currentPage + 1 %>&search=<%= search||'' %>&category=<%= selectedCategory||'' %>&sort=<%= sort||'' %>" class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">›</a>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">🔎</div>
      <h2>No Products Found</h2>
      <p>Try a different search or category filter</p>
      <a href="/products" class="btn-primary">Clear Filters</a>
    </div>
  <% } %>
</section>

<%- include('./partials/footer') %>

<script>
  let debTimer;
  document.getElementById('searchInput').addEventListener('input', function () {
    clearTimeout(debTimer);
    debTimer = setTimeout(() => document.getElementById('filterForm').submit(), 600);
  });

  document.querySelectorAll('.wishlist-toggle-form').forEach((form) => {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const productId = this.dataset.productId;
      const btn = this.querySelector('button');
      try {
        const res = await fetch(`/wishlist/toggle/${productId}`, {
          method: 'POST',
          headers: { Accept: 'application/json' }
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          if (data && data.redirect) window.location.href = data.redirect;
          return;
        }
        btn.textContent = data.status === 'added' ? '♥' : '♡';
      } catch (err) {
        console.error(err);
      }
    });
  });
</script>
