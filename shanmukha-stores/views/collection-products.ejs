<%- include('./partials/navbar') %>

    <style>
        .page-header {
            padding: 60px 20px;
            text-align: center;
            border-radius: 0 0 20px 20px;
            margin-bottom: 30px;
            position: relative;
        }

        .page-header .section-label {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .page-header h1 {
            font-size: 42px;
            margin: 0;
            font-weight: 800;
        }

        @media (max-width: 768px) {
            .page-header {
                padding: 40px 15px;
            }

            .page-header h1 {
                font-size: 32px;
            }
        }
    </style>

    <div class="page-header" id="collectionPageHeader" data-bg="<%= collection.image || '/images/placeholder.png' %>">
        <script>
            (function () {
                const h = document.getElementById('collectionPageHeader');
                h.style.background = "linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('" + h.getAttribute('data-bg') + "') center/cover";
                h.style.color = "white";
            })();
        </script>
        <div class="section-label" style="background: rgba(255,255,255,0.2); backdrop-filter: blur(4px); color: white;">
            Collection</div>
        <h1 style="color: white; text-shadow: 0 2px 10px rgba(0,0,0,0.3);">
            <%= collection.name %>
        </h1>
        <p
            style="color: rgba(255,255,255,0.9); text-shadow: 0 1px 5px rgba(0,0,0,0.5); max-width: 600px; margin: 10px auto 0;">
            <%= collection.description || 'Explore our exclusive ' + collection.name + ' products.' %>
        </p>
    </div>

    <section class="products-section products-page">
        <form method="GET" action="/collections/<%= collection.id %>" id="filterForm">
            <div class="filter-bar" style="justify-content: flex-end;">
                <select name="sort" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                    <option value="">Sort: Default</option>
                    <option value="price-asc" <%=(typeof sort !=='undefined' && sort==='price-asc' ) ? 'selected' : ''
                        %>>Price: Low to High</option>
                    <option value="price-desc" <%=(typeof sort !=='undefined' && sort==='price-desc' ) ? 'selected' : ''
                        %>>Price: High to Low</option>
                    <option value="rating" <%=(typeof sort !=='undefined' && sort==='rating' ) ? 'selected' : '' %>
                        >Top
                        Rated</option>
                </select>
            </div>
        </form>

        <p class="results-count">
            Showing <strong>
                <%= products.length %>
            </strong> products in this collection
        </p>

        <% if (products && products.length> 0) { %>
            <div class="products-grid">
                <% products.forEach((p)=> { %>
                    <div class="product-card">
                        <div class="product-image">
                            <a href="/products/<%= p.id %>">
                                <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>"
                                    onerror="this.src='/images/placeholder.png'">
                            </a>

                            <% if (p.stock===0) { %>
                                <span class="product-badge sale">Sold Out</span>
                                <% } %>

                                        <form action="/wishlist/toggle/<%= p.id %>" method="POST"
                                            class="wishlist-toggle-form wishlist-form-inline"
                                            data-product-id="<%= p.id %>">
                                            <button type="submit" class="wishlist-btn" title="Wishlist">♡</button>
                                        </form>
                        </div>

                        <div class="product-info">
                            <p class="product-category-tag">
                                <%= p.category_name || 'Grocery' %>
                            </p>
                            <h3 class="product-name"><a href="/products/<%= p.id %>">
                                    <%= p.name %>
                                </a></h3>

                            <div class="product-rating small">
                                <span class="stars" style="--rating: <%= p.average_rating || 0 %>;"></span>
                                <% if (p.review_count > 0) { %>
                                    <span class="rating-text">(<%= p.review_count %>)</span>
                                <% } %>
                            </div>

                            <p class="product-price">&#8377;<%= Number(p.effective_price ||
                                    p.price).toLocaleString('en-IN') %>
                                    <% if (p.price_type==='kg' ) { %> <span class="price-unit-note">per kg</span>
                                        <% } else { %> <span class="price-unit-note">per unit</span>
                                        <% } %>
                            </p>
                            <% if (p.stock===0) { %>
                                <div class="out-of-stock-label">Out of Stock</div>
                                <% } else { %>
                                    <form action="/cart/add/<%= p.id %>" method="POST">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="add-cart-btn">Add to Cart</button>
                                    </form>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon">🔎</div>
                    <h2>No Products Here</h2>
                    <p>There are no products assigned to this collection right now.</p>
                    <a href="/collections" class="btn-primary">Back to Collections</a>
                </div>
                <% } %>
    </section>

    <%- include('./partials/footer') %>

        <script>
            document.querySelectorAll('.wishlist-toggle-form').forEach((form) => {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const productId = this.dataset.productId;
                    const btn = this.querySelector('button');
                    try {
                        const res = await fetch(`/wishlist/toggle/${productId}`, {
                            method: 'POST',
                            headers: { Accept: 'application/json' }
                        });
                        const data = await res.json();
                        if (!res.ok || !data.ok) {
                            if (data && data.redirect) window.location.href = data.redirect;
                            return;
                        }
                        btn.textContent = data.status === 'added' ? '♥' : '♡';
                    } catch (err) {
                        console.error(err);
                    }
                });
            });
        </script>
