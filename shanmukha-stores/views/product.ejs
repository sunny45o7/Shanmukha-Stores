                    </style>

                    <div id="productConfig"
                        data-base-price="<%= Number((pricing && pricing.basePrice) || product.price) %>"
                        data-offer-percent="<%= Number((pricing && pricing.offerPercent) || 0) %>"
                        data-coupon-type="<%= appliedCoupon ? appliedCoupon.discount_type : '' %>"
                        data-coupon-value="<%= appliedCoupon ? Number(appliedCoupon.discount_value) : 0 %>"
                        data-coupon-max="<%= appliedCoupon && appliedCoupon.max_discount ? Number(appliedCoupon.max_discount) : 0 %>"
                        data-price-type="<%= product.price_type %>"
                        data-weights='<%= JSON.stringify(weightOptions || []) %>'>
                    </div>

                    <script>
                        function switchMainImage(url, el) {
                            document.getElementById('mainProductImg').src = url;
                            document.querySelectorAll('.thumb-item').forEach(item => item.classList.remove('active'));
                            el.classList.add('active');
                        }

                        function adjustQty(delta) {
                            const input = document.getElementById('qtyInput');
                            const max = parseInt(input.max) || 999;
                            const newVal = Math.max(1, Math.min(max, parseInt(input.value || 1) + delta));
                            input.value = newVal;

                            // Trigger price update when quantity changes
                            const weightInput = document.querySelector('input[name="selected_weight"]:checked');
                            updatePriceDisplay(weightInput ? weightInput.value : null);
                        }

                        // Simple Zoom Effect
                        const zoomContainer = document.getElementById('imageZoom');
                        const mainImg = document.getElementById('mainProductImg');

                        zoomContainer.addEventListener('mousemove', (e) => {
                            const rect = zoomContainer.getBoundingClientRect();
                            const x = (e.clientX - rect.left) / rect.width * 100;
                            const y = (e.clientY - rect.top) / rect.height * 100;
                            mainImg.style.transformOrigin = `${x}% ${y}%`;
                            mainImg.style.transform = 'scale(1.8)';
                        });

                        zoomContainer.addEventListener('mouseleave', () => {
                            mainImg.style.transform = 'scale(1)';
                        });

                        const configEl = document.getElementById('productConfig');
                        const basePrice = Number(configEl.dataset.basePrice);
                        const offerPercent = Number(configEl.dataset.offerPercent);
                        const couponType = configEl.dataset.couponType;
                        const couponValue = Number(configEl.dataset.couponValue);
                        const couponMaxDiscount = Number(configEl.dataset.couponMax);
                        const priceType = configEl.dataset.priceType;
                        const weightOptions = JSON.parse(configEl.dataset.weights || '[]');
                        const priceDisplay = document.getElementById('priceBlock');

                        function formatAmount(value) {
                            return Number(value || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 }).replace(/\.00$/, '');
                        }

                        function getWeightMultiplier(weight) {
                            const raw = String(weight || '').trim().toLowerCase().replace(/\s+/g, '');
                            const match = raw.match(/^(\d+(?:\.\d+)?)(kg|g|gm)$/);
                            if (!match) return 1;
                            const qty = Number(match[1]);
                            if (!Number.isFinite(qty) || qty <= 0) return 1;
                            const unit = match[2];
                            return unit === 'kg' ? qty : (qty / 1000);
                        }

                        function updatePriceDisplay(weight) {
                            const qtyInput = document.getElementById('qtyInput');
                            const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;

                            let multiplier = 1;
                            if (priceType === 'kg') {
                                if (!weight) {
                                    const checkedInput = document.querySelector('input[name="selected_weight"]:checked');
                                    weight = checkedInput ? checkedInput.value : (weightOptions.length ? weightOptions[0] : '1kg');
                                }
                                multiplier = getWeightMultiplier(weight);
                            }

                            const currentBaseTotal = basePrice * multiplier * qty;
                            const offeredTotal = offerPercent > 0 ? currentBaseTotal * (1 - offerPercent / 100) : currentBaseTotal;

                            let couponDiscount = 0;
                            if (couponType === 'percent') {
                                couponDiscount = offeredTotal * (couponValue / 100);
                                if (couponMaxDiscount > 0) couponDiscount = Math.min(couponDiscount, couponMaxDiscount);
                            } else if (couponType === 'fixed') {
                                couponDiscount = couponValue;
                            }
                            couponDiscount = Math.min(couponDiscount, offeredTotal);

                            const finalTotal = Math.max(offeredTotal - couponDiscount, 0);

                            if (!priceDisplay) return;
                            const isDiscounted = currentBaseTotal > finalTotal;
                            if (isDiscounted) {
                                priceDisplay.innerHTML = `
                                    <div class="old-price">&#8377;${formatAmount(currentBaseTotal)}</div>
                                    <div class="new-price">&#8377;${formatAmount(finalTotal)}</div>
                                    <div class="price-tags">
                                        ${offerPercent > 0 ? `<span class="price-chip offer-chip">${offerPercent.toFixed(2).replace(/\\.00$/, '')}% OFF</span>` : ''}
                                        ${couponType ? `<span class="price-chip coupon-chip">COUPON APPLIED</span>` : ''}
                                    </div>
                                    <div class="price-unit-note">${priceType === 'kg' ? 'per kg' : 'per unit'}</div>
                                `;
                            } else {
                                priceDisplay.innerHTML = `
                                    <div class="new-price">&#8377;${formatAmount(finalTotal)}</div>
                                    <div class="price-unit-note">${priceType === 'kg' ? 'per kg' : 'per unit'}</div>
                                `;
                            }
                        }

                        // Always recalculate from currently selected weight on page load
                        // This fixes the bug where coupon price was shown for 1kg even when a different weight is selected
                        (function initPriceDisplay() {
                            if (priceType === 'kg') {
                                const checkedWeight = document.querySelector('input[name="selected_weight"]:checked');
                                const fallbackWeight = weightOptions.length ? weightOptions[0] : '1kg';
                                updatePriceDisplay(checkedWeight ? checkedWeight.value : fallbackWeight);
                            } else {
                                updatePriceDisplay();
                            }
                        })();

                        // ============================================================
                        // STAR PICKER LOGIC
                        // ============================================================
                        (function () {
                            const starLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
                            const picker = document.getElementById('starPicker');
                            const ratingInput = document.getElementById('ratingInput');
                            const labelTxt = document.getElementById('starLabelTxt');
                            const submitBtn = document.getElementById('submitReviewBtn');
                            if (!picker) return;

                            const btns = picker.querySelectorAll('.star-pick-btn');
                            let selectedVal = 0;

                            function highlightUpTo(n, cls) {
                                btns.forEach((b, idx) => {
                                    b.classList.remove('hovered', 'selected');
                                    if (idx < n) b.classList.add(cls);
                                });
                            }

                            btns.forEach((btn, idx) => {
                                const val = idx + 1;
                                btn.addEventListener('mouseenter', () => {
                                    if (selectedVal === 0) highlightUpTo(val, 'hovered');
                                    labelTxt.textContent = starLabels[val] || '';
                                });
                                btn.addEventListener('mouseleave', () => {
                                    highlightUpTo(selectedVal, 'selected');
                                    labelTxt.textContent = selectedVal > 0 ? `You selected: ${starLabels[selectedVal]}` : 'Click a star to rate';
                                });
                                btn.addEventListener('click', () => {
                                    selectedVal = val;
                                    ratingInput.value = val;
                                    submitBtn.disabled = false;
                                    highlightUpTo(val, 'selected');
                                    labelTxt.textContent = `You selected: ${starLabels[val]}`;
                                });
                            });

                            // If URL has success message, scroll to reviews
                            if (window.location.search.includes('success=Review')) {
                                const revSection = document.getElementById('reviews-section');
                                if (revSection) setTimeout(() => revSection.scrollIntoView({ behavior: 'smooth' }), 400);
                            }
                        })();

                        async function toggleWishlist(prodId, btn) {
                            try {
                                const res = await fetch('/wishlist/toggle/' + prodId, {
                                    method: 'POST',
                                    headers: { 'Accept': 'application/json' }
                                });
                                const data = await res.json();
                                if (!res.ok || !data.ok) {
                                    if (data && data.redirect) {
                                        window.location.href = data.redirect;
                                        return;
                                    }
                                    return;
                                }
                                const icon = btn ? btn.querySelector('svg') : null;
                                if (data.status === 'added') {
                                    btn.classList.add('active');
                                    if (icon) icon.setAttribute('fill', 'currentColor');
                                } else {
                                    btn.classList.remove('active');
                                    if (icon) icon.setAttribute('fill', 'none');
                                }
                            } catch (err) {
                                console.error(err);
                            }
                        }
                    </script>
